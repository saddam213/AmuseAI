<Views:ViewBase x:Class="Amuse.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Common="clr-namespace:Amuse.App.Common"
    xmlns:Views="clr-namespace:Amuse.App.Views"
    mc:Ignorable="d">

    <Views:ViewBase.Resources>

        <!--Card-->
        <Style x:Key="HomeCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource ContainerBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="5,5,10,5"/>
        </Style>

        <!--Section Header-->
        <Style x:Key="HomeSectionHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value=".9"/>
            <Setter Property="Margin" Value="5,16,5,2"/>
        </Style>

        <!--Create Shortcut-->
        <Style x:Key="HomeShortcutButton" TargetType="{x:Type CommonControls:IconButton}" BasedOn="{StaticResource SubmenuIconButton}">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IconSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>

        <!--Backend Status Icon-->
        <Style x:Key="HomeBackendStatusIcon" TargetType="{x:Type CommonControls:FontAwesome}" BasedOn="{StaticResource {x:Type CommonControls:FontAwesome}}">
            <Setter Property="Icon" Value="f05e"/>
            <Setter Property="Size" Value="13"/>
            <Setter Property="Color" Value="{StaticResource DefaultForeground}"/>
            <Setter Property="Opacity" Value=".35"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready">
                    <Setter Property="Icon" Value="f00c"/>
                    <Setter Property="Color" Value="{StaticResource SuccessColour}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                    <Setter Property="Icon" Value="f0ed"/>
                    <Setter Property="Color" Value="{StaticResource WarningColour}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--Backend Status Text-->
        <Style x:Key="HomeBackendStatusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="{CommonControls:Localize BackendUnsupported}"/>
            <Setter Property="Opacity" Value=".35"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready">
                    <Setter Property="Text" Value="{CommonControls:Localize BackendReady}"/>
                    <Setter Property="Opacity" Value=".9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                    <Setter Property="Text" Value="{CommonControls:Localize BackendNotInstalled}"/>
                    <Setter Property="Opacity" Value=".9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--Backend Status Cell-->
        <Style x:Key="HomeBackendStatusCell" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_BackendUnsupported}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready">
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_BackendReady}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_BackendNotInstalled}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--Model Card-->
        <DataTemplate x:Key="HomeModelTemplate">
            <Button Style="{StaticResource HighlightButton}" Height="64" Margin="0,0,6,6" Padding="4,6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding OpenModelCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HomeView}}}" CommandParameter="{Binding}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom">
                        <CommonControls:FontAwesome DockPanel.Dock="Right" Style="{StaticResource ModelStatusFontAwesome}" Tag="{Binding Status}" Size="12" ToolTipService.InitialShowDelay="200"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentColour1}" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Backend, Converter={StaticResource EnumShortNameConverter}}" Foreground="White" FontSize="10" Margin="5,1" Opacity=".9"/>
                            </Border>
                            <TextBlock Text="{Binding MediaType}" FontSize="11" Opacity=".6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HomeWrapPanel">
            <UniformGrid Columns="6"/>
        </ItemsPanelTemplate>

    </Views:ViewBase.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:HomeView}}}">

        <StackPanel Margin="25,15,25,20" MaxWidth="1500">

            <!--Header-->
            <StackPanel Margin="5,0,5,6">
                <TextBlock Text="{CommonControls:Localize HomeTitle}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{CommonControls:Localize HomeSubtitle}" FontSize="13" Opacity=".7"/>
            </StackPanel>

            <!--Create-->
            <UniformGrid Columns="4">

                <!--Image-->
                <Border Style="{StaticResource HomeCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <CommonControls:FontAwesome Icon="f03e" IconStyle="SharpLight" Size="20" Color="{StaticResource AccentColour2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{CommonControls:Localize Image}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize HomeImageDescription}" TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextToImage}" Icon="f894" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextToImage}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageToImage}" Icon="f03e" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageToImage}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageEdit}" Icon="f4a4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageEdit}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageInpaint}" Icon="f044" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageInpaint}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_PaintToImage}" Icon="f1fc" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.PaintToImage}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageUpscale}" Icon="f424" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageUpscale}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!--Video-->
                <Border Style="{StaticResource HomeCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <CommonControls:FontAwesome Icon="f008" IconStyle="SharpLight" Size="20" Color="{StaticResource AccentColour2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{CommonControls:Localize Video}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize HomeVideoDescription}" TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextToVideo}" Icon="f894" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextToVideo}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageToVideo}" Icon="f03e" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageToVideo}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_VideoToVideo}" Icon="f008" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.VideoToVideo}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_MediaToVideo}" Icon="f87c" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.MediaToVideo}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_VideoUpscale}" Icon="f424" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.VideoUpscale}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_VideoInterpolate}" Icon="e4a2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.VideoInterpolate}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!--Audio-->
                <Border Style="{StaticResource HomeCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <CommonControls:FontAwesome Icon="f001" IconStyle="SharpLight" Size="20" Color="{StaticResource AccentColour2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{CommonControls:Localize Audio}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize HomeAudioDescription}" TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextToMusic}" Icon="f8c9" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextToMusic}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextToAudio}" Icon="f894" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextToAudio}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_AudioToText}" Icon="f001" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.AudioToText}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!--Text-->
                <Border Style="{StaticResource HomeCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <CommonControls:FontAwesome Icon="f893" IconStyle="Regular" Size="20" Color="{StaticResource AccentColour2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{CommonControls:Localize Text}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize HomeTextDescription}" TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextConverse}" Icon="e1e7" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextConverse}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_TextInstruct}" Icon="e1e3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.TextInstruct}"/>
                            <CommonControls:IconButton Style="{StaticResource HomeShortcutButton}" Text="{CommonControls:Localize Menu_ImageToText}" Icon="f03e" Command="{Binding NavigateCommand}" CommandParameter="{x:Static Views:View.ImageToText}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!--Devices-->
            <DockPanel Margin="0,16,6,2">
                <CommonControls:IconButton DockPanel.Dock="Right" Text="{CommonControls:Localize ManageEnvironments}" Icon="f233" IconSize="13" FontSize="12" Width="170" Height="24" Margin="5,0" IconColor="{StaticResource AccentColour2}" Command="{Binding ManageEnvironmentsCommand}"/>
                <TextBlock Text="{CommonControls:Localize HomeDevices}" Style="{StaticResource HomeSectionHeader}" Margin="5,0"/>
            </DockPanel>
            <Border Style="{StaticResource HomeCard}">
                <StackPanel>

                    <!--System-->
                    <WrapPanel Margin="0,0,0,8" Opacity=".8">
                        <CommonControls:FontAwesome Icon="f2db" IconStyle="Light" Size="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CPUName}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SystemMemory, StringFormat={}{0} GB RAM}" Margin="12,0,0,0" Opacity=".7" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" Visibility="{Binding NPUName, Converter={StaticResource NullVisibilityConverter}}">
                            <CommonControls:FontAwesome Icon="f544" IconStyle="Light" Size="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NPUName}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <!--Backend Header-->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="300" Text="{CommonControls:Localize Device}" FontWeight="SemiBold" Opacity=".7"/>
                        <ItemsControl ItemsSource="{Binding Backends}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock 
                                        Text="{Binding ., Converter={StaticResource EnumShortNameConverter}}"
                                        FontWeight="SemiBold" Opacity=".7"
                                        ToolTip="{Binding ., Converter={StaticResource EnumDescriptionConverter}}" 
                                        ToolTipService.InitialShowDelay="200"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource ContainerBorder}" BorderThickness="0,1,0,0" Margin="0,0,0,4"/>

                    <!--Device Rows-->
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type Common:HomeDeviceItem}">
                                <DockPanel Margin="0,5,0,0">
                                    <StackPanel DockPanel.Dock="Left" Width="300">
                                        <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Opacity=".6">
                                            <TextBlock Text="{Binding Device.Vendor}" FontSize="11"/>
                                            <TextBlock Text="{Binding Device.MemoryGB, StringFormat={} · {0} GB}" FontSize="11"/>
                                            <TextBlock Text="{Binding Device.DeviceType, StringFormat={} · {0}}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Backends}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type Common:HomeBackendItem}">
                                                <StackPanel Style="{StaticResource HomeBackendStatusCell}" HorizontalAlignment="Left">
                                                    <CommonControls:FontAwesome Style="{StaticResource HomeBackendStatusIcon}" VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource HomeBackendStatusText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{CommonControls:Localize NoDevicesFound}" FontStyle="Italic" Opacity=".5">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--Recent Models-->
            <StackPanel>
                <TextBlock Text="{CommonControls:Localize RecentModels}" Style="{StaticResource HomeSectionHeader}"/>
                <ItemsControl ItemsSource="{Binding RecentModels}" ItemTemplate="{StaticResource HomeModelTemplate}" ItemsPanel="{StaticResource HomeWrapPanel}" Margin="5,4,5,0"/>
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentModels.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>

            <!--New Models-->
            <StackPanel>
                <TextBlock Text="{CommonControls:Localize NewModels}" Style="{StaticResource HomeSectionHeader}"/>
                <ItemsControl ItemsSource="{Binding NewModels}" ItemTemplate="{StaticResource HomeModelTemplate}" ItemsPanel="{StaticResource HomeWrapPanel}" Margin="5,4,5,0"/>
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NewModels.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>

            <!--Recommended Models-->
            <StackPanel>
                <TextBlock Text="{CommonControls:Localize RecommendedModels}" Style="{StaticResource HomeSectionHeader}"/>
                <ItemsControl ItemsSource="{Binding RecommendedModels}" ItemTemplate="{StaticResource HomeModelTemplate}" ItemsPanel="{StaticResource HomeWrapPanel}" Margin="5,4,5,0"/>
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecommendedModels.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>



        </StackPanel>

    </Grid>
</Views:ViewBase>
