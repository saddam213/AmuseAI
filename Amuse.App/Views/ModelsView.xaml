<Views:ViewBase x:Class="Amuse.App.Views.ModelsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Common="clr-namespace:Amuse.App.Common"
    xmlns:Resources="clr-namespace:Amuse.App.Resources"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Views:ViewBase.Resources>
        <Style x:Key="StatusIcon" TargetType="{x:Type CommonControls:FontAwesome}" >
            <Setter Property="Opacity" Value=".6"/>
            <Setter Property="Color" Value="{StaticResource DefaultForeground}"/>
            <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_NotInstalled}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"  Value="Installed">
                    <Setter Property="Color" Value="{StaticResource SuccessColour}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_Installed}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Available">
                    <Setter Property="Opacity" Value=".2"/>
                    <Setter Property="Color" Value="{StaticResource DefaultForeground}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_Available}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Unknown">
                    <Setter Property="Color" Value="{StaticResource WarningColour}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_Unknown}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="DownloadQueue">
                    <Setter Property="Color" Value="{StaticResource WarningColour}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_DownloadQueue}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Downloading">
                    <Setter Property="Color" Value="{StaticResource InfoColour}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_Downloading}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="DownloadFailed">
                    <Setter Property="Color" Value="{StaticResource DangerColour}"/>
                    <Setter Property="ToolTip" Value="{CommonControls:Localize ToolTip_ModelStatus_DownloadFailed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--ModelRow-->
        <Style x:Key="ModelRowContainer" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--ModelItem-->
        <Style x:Key="ModelItemBorder" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlMouseOverBackground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--PublisherLogo-->
        <DataTemplate x:Key="PublisherLogoTemplate" DataType="{x:Type Common:ModelMetadata}">
            <Border Width="60" Height="60" CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding PublisherModel.IconSource, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding PublisherModel.IconSource, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </DataTemplate>

        <!--Publisher-->
        <DataTemplate x:Key="PublisherTemplate" DataType="{x:Type Common:ModelMetadata}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="{Binding PublisherModel, Converter={StaticResource NullVisibilityConverter}}">
                <Border Width="20" Height="20" CornerRadius="3" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding PublisherModel.IconSource, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding PublisherModel.IconSource, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <CommonControls:HyperlinkControl Link="{Binding PublisherModel.Link}" Label="{Binding PublisherModel.Name}" Foreground="DeepSkyBlue" FontSize="14" VerticalAlignment="Center" Visibility="{Binding PublisherModel.Link, Converter={StaticResource NullVisibilityConverter}}" />
                <TextBlock Text="{Binding PublisherModel.Name}" FontSize="14" VerticalAlignment="Center" Visibility="{Binding PublisherModel.Link, Converter={StaticResource InverseNullVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>

        <!--Licence-->
        <DataTemplate x:Key="LicenceTemplate" DataType="{x:Type Common:ModelMetadata}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontStyle="Italic" Opacity=".7" Margin="0,0,6,0" Text="{CommonControls:Localize Licence, Append=:}" Visibility="{Binding License, Converter={StaticResource NullVisibilityConverter}}" />
                <CommonControls:HyperlinkControl Grid.Row="0" Grid.Column="1" Link="{Binding LicenseLink}" Label="{Binding License}" Foreground="DeepSkyBlue" Visibility="{Binding License, Converter={StaticResource NullVisibilityConverter}}" />
                <TextBlock Grid.Row="1" Grid.Column="0" FontStyle="Italic" Opacity=".7" Margin="0,0,6,0" Text="{CommonControls:Localize Source, Append=:}" Visibility="{Binding SourceLink, Converter={StaticResource NullVisibilityConverter}}" />
                <CommonControls:HyperlinkControl Grid.Row="1" Grid.Column="1" Link="{Binding SourceLink}" Label="{Binding SourceLink}" Foreground="DeepSkyBlue" Opacity=".9" ToolTip="{Binding SourceLink}" ToolTipService.InitialShowDelay="200" Visibility="{Binding SourceLink, Converter={StaticResource NullVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Views:ViewBase.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ModelsView}}}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="1*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!--Collection-->

        <DockPanel Grid.Column="0"  Margin="10,10,5,10">

            <!--Top Panel-->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" Padding="4,0,4,4" >
                <DockPanel>

                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="" Style="{StaticResource FieldTextBlockStyle}"/>
                        <CommonControls:IconButton Icon="f00d" IconColor="{StaticResource DangerColour}"  Command="{Binding RemoveFiltersCommand}" Width="22" Height="22"/>
                    </StackPanel>
                    <UniformGrid DockPanel.Dock="Right" Rows="1" Width="780">
                        <StackPanel>
                            <TextBlock Text="{CommonControls:Localize ModelType}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <CommonControls:NullableComboBox ItemsSource="{Binding Source={StaticResource ModelCategoryType}}" SelectedItem="{Binding FilterCategoryType}" NullPrefix="{x:Static Resources:AppDefault.AllModels}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{CommonControls:Localize MediaType}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <CommonControls:NullableComboBox ItemsSource="{Binding Source={StaticResource MediaType}}" SelectedItem="{Binding FilterMediaType}" NullPrefix="{x:Static Resources:AppDefault.AllMedia}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{CommonControls:Localize PipelineType}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding FilterPipelines}" SelectedItem="{Binding FilterPipeline}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{Binding}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="">
                                                            <Setter Property="Text" Value="{CommonControls:Localize AllPipelines}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{CommonControls:Localize BackendType}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <CommonControls:NullableComboBox ItemsSource="{Binding Source={StaticResource BackendType}}" SelectedItem="{Binding FilterBackendType}" NullPrefix="{x:Static Resources:AppDefault.AllBackends}"/>
                        </StackPanel>

                    </UniformGrid>
                    <StackPanel>
                        <TextBlock Text="{CommonControls:Localize Search}" Style="{StaticResource FieldTextBlockStyle}"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Bottom Panel-->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" Padding="4,0,4,0" >
                <DockPanel Height="30">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{CommonControls:Localize Items, Append=:}" Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding ModelCount}" />
                        <TextBlock Text=" / " />
                        <TextBlock Text="{Binding ModelCollection.SourceCollection.Count}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <UniformGrid Rows="1">
                            <CheckBox Content="{CommonControls:Localize ShowComponents}" IsChecked="{Binding FilterComponents}" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <CheckBox Content="{CommonControls:Localize ShowInstalled}" IsChecked="{Binding FilterInstalled}" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <CommonControls:IconButton Text="{CommonControls:Localize QueueAll}" Icon="f0ed" IconStyle="Light" IconColor="{StaticResource AccentColour2}" Command="{Binding QueueAllCommand}" Height="24"  ToolTip="{CommonControls:Localize ToolTip_QueueAll}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowOnDisabled="True"/>
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock />
                </DockPanel>
            </Border>

            <!--Middle-->
            <Border BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" Margin="0,4">
                <Grid>
                    <ListBox x:Name="ListBoxControl"
                            Padding="0"
                            BorderThickness="0"
                            Background="{StaticResource TransparentBrush}"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.PanningMode="VerticalOnly"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.ScrollChanged="ListBoxControl_ScrollChanged"
                            PreviewMouseWheel="ListBoxControl_PreviewMouseWheel"
                            ItemsSource="{Binding ModelRows}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ItemContainerStyle="{StaticResource ModelRowContainer}">

                        <!--DataTemplates-->
                        <ListBox.Resources>

                            <!--DiffusionModel-->
                            <DataTemplate DataType="{x:Type Common:DiffusionModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Opacity=".2" Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <Grid Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}">
                                                    <CommonControls:FontAwesome Icon="f03e" IconStyle="SharpLight" Size="80" Color="{StaticResource DefaultForeground}"  />
                                                </Grid>
                                                <Grid Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}">
                                                    <CommonControls:FontAwesome Icon="f008" IconStyle="SharpLight" Size="80" Color="{StaticResource DefaultForeground}" />
                                                </Grid>
                                                <Grid Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Audio}">
                                                    <CommonControls:FontAwesome Icon="f001" IconStyle="SharpRegular" Size="76" Color="{StaticResource DefaultForeground}" Margin="0,4,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{Binding Backend}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>

                            </DataTemplate>

                            <!--LanguageModel-->
                            <DataTemplate DataType="{x:Type Common:LanguageModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <Grid Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}" >
                                                    <CommonControls:FontAwesome Icon="f893" IconStyle="SharpSolid" Size="80" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{Binding Backend}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                            <!--LoraAdapterModel-->
                            <DataTemplate DataType="{x:Type Common:LoraAdapterModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <CommonControls:FontAwesome Icon="f1e0" IconStyle="SharpLight" Size="70" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{CommonControls:Localize LoraAdapter}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                            <!--ControlNetModel-->
                            <DataTemplate DataType="{x:Type Common:ControlNetModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <CommonControls:FontAwesome Icon="f78a" IconStyle="SharpLight" Size="60" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10" />
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{CommonControls:Localize ControlNet}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                            <!--UpscaleModel-->
                            <DataTemplate DataType="{x:Type Common:UpscaleModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <CommonControls:FontAwesome Icon="f424" IconStyle="SharpLight" Size="68" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{Binding Backend}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                            <!--ExtractModel-->
                            <DataTemplate DataType="{x:Type Common:ExtractModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <CommonControls:FontAwesome Icon="f302" IconStyle="SharpLight" Size="68" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Pipeline, Converter={StaticResource EnumShortNameConverter}}"/>
                                            <TextBlock Text="{Binding Backend}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                            <!--ComponentModel-->
                            <DataTemplate DataType="{x:Type Common:ComponentModel}">
                                <Grid>
                                    <DockPanel Height="80">
                                        <Grid DockPanel.Dock="Left" Width="80" Height="80" Margin="4,0,0,0">
                                            <ContentControl Content="{Binding Metadata}" ContentTemplate="{StaticResource PublisherLogoTemplate}" Focusable="False" />
                                            <Grid Visibility="{Binding Metadata.PublisherModel.IconSource, Converter={StaticResource InverseNullVisibilityConverter}}">
                                                <CommonControls:FontAwesome Icon="e479" IconStyle="SharpLight" Size="78" Color="{StaticResource DefaultForeground}" Opacity=".2" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="13" FontWeight="DemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
                                        <StackPanel Margin="4,6,0,0" Opacity=".7">
                                            <TextBlock Text="{Binding Checkpoint.Folder}"/>
                                            <TextBlock Text="{CommonControls:Localize Component}" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CommonControls:FontAwesome Style="{StaticResource StatusIcon}" Tag="{Binding Status}" Icon="f0ed" IconStyle="Solid" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" />
                                </Grid>
                            </DataTemplate>

                        </ListBox.Resources>

                        <!--Rows-->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Opacity=".9" Margin="6,12,5,4" Visibility="{Binding Header, Converter={StaticResource NullVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Visibility="{Binding Items, Converter={StaticResource NullVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="{Binding Columns}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ModelItemBorder}" MouseLeftButtonDown="ModelItem_MouseLeftButtonDown">
                                                    <ContentControl Content="{Binding Model}" Focusable="False" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <Grid Visibility="{Binding ModelCount, Converter={StaticResource LessOrEqualThanToVisibilityConverter}, ConverterParameter=0}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{CommonControls:Localize NoItemsFound}" FontSize="18" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </DockPanel>

        <!--GridSplitter-->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Opacity=".4" Margin="0,20" />

        <!--Information-->
        <DockPanel Grid.Column="2" Margin="5, 10, 10, 10">

            <!--SelectedItem-->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DefaultBorderColor}" BorderThickness="1" >
                <DockPanel Height="420" Margin="0,6,0,0">

                    <DockPanel DockPanel.Dock="Bottom"  Margin="6" >
                        <UniformGrid Rows="1" Height="32" Margin="0,6,0,0">
                            <Grid>
                                <CommonControls:IconButton Text="{CommonControls:Localize Download}" FontSize="13" Icon="f0ed" IconSize="16" IconStyle="Light" IconColor="{StaticResource AccentColour2}" Command="{Binding DownloadCommand}" />
                                <CommonControls:IconButton Text="{CommonControls:Localize Update}" FontSize="13" Icon="f0ed" IconSize="16" IconStyle="Light" IconColor="{StaticResource WarningColour}" Command="{Binding DownloadCommand}" Visibility="{Binding SelectedItem.Status, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Unknown}"/>
                            </Grid>
                            <CommonControls:IconButton Text="{CommonControls:Localize Information}" FontSize="13" Icon="f05a" IconSize="16" IconStyle="Light"  IconColor="{StaticResource InfoColour}" Command="{Binding DownloadInformationCommand}" />
                        </UniformGrid>
                    </DockPanel>

                    <!--DataTemplate-->
                    <Grid >
                        <ContentControl Content="{Binding SelectedItem}" Foreground="{StaticResource DefaultForeground}" >
                            <ContentControl.Resources>

                                <!--DiffusionModel-->
                                <DataTemplate DataType="{x:Type Common:DiffusionModel}">
                                    <DockPanel>

                                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding Metadata}" ContentTemplate="{StaticResource LicenceTemplate}" Margin="30,0,10,10" Focusable="False" />
                                        <Grid DockPanel.Dock="Bottom" Margin="30,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" FontStyle="Italic" Opacity=".7" Text="{CommonControls:Localize Memory, Append=:}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemorySize, StringFormat={}{0}GB}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" FontStyle="Italic" Opacity=".7" Text="{CommonControls:Localize Type, Append=:}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ModelType}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" FontStyle="Italic" Opacity=".7" Text="{CommonControls:Localize Status, Append=:}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status, Converter={StaticResource EnumDisplayNameConverter}}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" FontStyle="Italic" Opacity=".7" Text="{CommonControls:Localize Output, Append=:}" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MediaType}" />
