<Views:ViewBase x:Class="Amuse.App.Views.SettingsGeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:app="clr-namespace:Amuse.App"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SettingsGeneralView}}}" Margin="10, 20, 20, 20"  >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" VerticalAlignment="Top">
                <Button DockPanel.Dock="Bottom" Command="{Binding SaveCommand}" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <CommonControls:FontAwesome Icon="f0c7" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                        <TextBlock Text="{CommonControls:Localize SaveChanges}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel >

                    <!--Model Settings-->
                    <GroupBox Header="{CommonControls:Localize ModelSettings}">
                        <StackPanel Margin="6">
                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" >
                                    <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryModel, Mode=OneWay}" />
                                    <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveModelDirectoryCommand}" />
                                </UniformGrid>
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize ModelDirectory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding Settings.DirectoryModel, Mode=OneWay}" IsReadOnly="True" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>



                    <!--History Settings-->
                    <GroupBox Header="{CommonControls:Localize HistorySettings}" Margin="0,10,0,0">
                        <StackPanel Margin="6">

                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" >
                                    <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryHistory, Mode=OneWay}" />
                                    <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveHistoryDirectoryCommand}" />
                                </UniformGrid>
                                <StackPanel >
                                    <TextBlock Text="{CommonControls:Localize Directory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding Settings.DirectoryHistory, Mode=OneWay}" IsReadOnly="True"/>
                                </StackPanel>
                            </DockPanel>

                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,4,0" >
                                    <TextBlock Text="{CommonControls:Localize Orientation}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <ComboBox SelectedItem="{Binding Settings.HistoryOrientation, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource Orientation}}"  />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0" >
                                    <TextBlock Text="{CommonControls:Localize MaxItems}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox  Text="{Binding Settings.HistoryItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                </StackPanel>
                                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <CheckBox Content="{CommonControls:Localize AddRecentItems}" IsChecked="{Binding Settings.IsHistoryRecentItemsEnabled}"/>
                                </StackPanel>
                                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <CheckBox Content="{CommonControls:Localize SortByLastUsed}" IsChecked="{Binding Settings.IsHistoryAutoSortEnabled}"/>
                                </StackPanel>
                            </UniformGrid>

                        </StackPanel>
                    </GroupBox>

                    <!--Other Settings-->
                    <GroupBox Header="{CommonControls:Localize OtherSettings}" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <UniformGrid Columns="4" >
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{CommonControls:Localize Language}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:LocalizationControl UILanguage="{Binding Settings.UILanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{CommonControls:Localize UIScale}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedValue="{Binding Settings.UIScale, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                                </StackPanel>
                                <CheckBox Content="{CommonControls:Localize CheckForUpdates}" IsChecked="{Binding Settings.IsAutoUpdateEnabled}" Margin="5,20,0,0"/>
                                <CommonControls:HyperlinkControl Label="{CommonControls:Localize LogDirectory}" Link="{x:Static app:App.DirectoryLogs}" IsButtonType="True" VerticalAlignment="Stretch" Margin="0,8,0,0" />
                            </UniformGrid>

                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" >
                                    <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryTemp, Mode=OneWay}" />
                                    <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveTempDirectoryCommand}" />
                                </UniformGrid>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{CommonControls:Localize TempDirectory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding Settings.DirectoryTemp, Mode=OneWay}" IsReadOnly="True" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,6,0,0" Height="22">
                                <Button DockPanel.Dock="Right" Content="{CommonControls:Localize ResetDialogs}" Command="{Binding ResetDialogsCommand}" Width="150"/>
                                <UniformGrid Rows="1" >
                                    <CheckBox Content="{CommonControls:Localize EnableExternalLinks}" IsChecked="{Binding Settings.IsExternalLinksEnabled}" />
                                </UniformGrid>
                            </DockPanel>
                          
                        </StackPanel>
                    </GroupBox>


                    <!--Experimental Settings-->
                    <GroupBox Header="{CommonControls:Localize ExperimentalSettings}" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <UniformGrid Columns="1" >
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="{CommonControls:Localize PipelineDebug}" IsChecked="{Binding Settings.IsServerDebugEnabled}" />
                                    <TextBlock Text="Show the pipeline status in a seperate console window" FontSize="11" FontStyle="Italic" Opacity=".6" Margin="22,0,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="{CommonControls:Localize OptimizeDevice}" IsChecked="{Binding Settings.IsOptimizeDeviceEnabled}"  />
                                    <TextBlock Text="Set device specific optimizations (matmul_precision, reduced_precision, allow_tf32 etc.)" FontSize="11" FontStyle="Italic" Opacity=".6" Margin="22,0,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="{CommonControls:Localize OptimizeChannels}" IsChecked="{Binding Settings.IsOptimizeChannelsEnabled}" />
                                    <TextBlock Text="Set the model channel order NCHW -> NHWC" FontSize="11" FontStyle="Italic" Opacity=".6" Margin="22,0,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="{CommonControls:Localize DeviceQuantization}" IsChecked="{Binding Settings.IsDeviceQuantizationEnabled}" />
                                    <TextBlock Text="Quantize model on GPU device" FontSize="11" FontStyle="Italic" Opacity=".6" Margin="22,0,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="{CommonControls:Localize DiffusionStepPreview}" IsChecked="{Binding Settings.IsDiffusionImagePreviewEnabled}" />
                                    <TextBlock Text="Enable step preview images" FontSize="11" FontStyle="Italic" Opacity=".6" Margin="22,0,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </DockPanel>


            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <GroupBox Header="{CommonControls:Localize AccessTokens}" DockPanel.Dock="Top">
                    <ItemsControl ItemsSource="{Binding Settings.AccessTokens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel  Margin="6,0">
                                    <TextBlock Style="{StaticResource FieldTextBlockStyle}">
                                        <Run Text="{Binding Name}"/>
                                        <Run Text="Access Token"/>
                                    </TextBlock>
                                    <Grid>
                                        <TextBox x:Name="TextBoxControl" Text="{Binding Token}" />
                                        <Grid Visibility="{Binding IsFocused, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                            <Grid Visibility="{Binding IsMouseOver, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                                <Grid Visibility="{Binding Text, ElementName=TextBoxControl, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Background="{StaticResource ControlDefaultBackground}">
                                                    <TextBox Text="••••••••••••••••••••••••••••••••••••••••••••••••••••••" FontSize="16" Padding="1,-1,-1,-1" Margin="0"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <!--<ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid IsItemsHost="True" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>-->
                    </ItemsControl>
                </GroupBox>

                <TextBlock />
            </DockPanel>

        </Grid>
    </Grid>
</Views:ViewBase>
