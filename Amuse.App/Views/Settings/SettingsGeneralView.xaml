<Views:ViewBase x:Class="Amuse.App.Views.SettingsGeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:app="clr-namespace:Amuse.App"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SettingsGeneralView}}}" Margin="10, 20, 20, 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!--Settings-->
        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Bottom" Command="{Binding SaveCommand}" MinWidth="120" Padding="10,0" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <CommonControls:FontAwesome Icon="f0c7" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                    <TextBlock Text="{CommonControls:Localize SaveChanges}" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                        <!--Models-->
                        <Border Style="{StaticResource WizardSection}">
                            <DockPanel>
                                <StackPanel Style="{StaticResource WizardSectionHeader}">
                                    <TextBlock Text="{CommonControls:Localize Models}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{CommonControls:Localize GeneralModelsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <DockPanel>
                                        <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                            <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryModel, Mode=OneWay}" />
                                            <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveModelDirectoryCommand}" />
                                        </UniformGrid>
                                        <StackPanel>
                                            <TextBlock Text="{CommonControls:Localize ModelDirectory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                            <TextBox Text="{Binding Settings.DirectoryModel, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0" Height="22">
                                        <UniformGrid DockPanel.Dock="Right" Columns="2" Width="304" Margin="4,0,0,0">
                                            <Button Content="{CommonControls:Localize RescanModels}" Command="{Binding RescanModelsCommand}" Margin="0,0,2,0" ToolTip="{CommonControls:Localize ToolTip_RescanModels}" ToolTipService.InitialShowDelay="200"/>
                                            <Button Content="{CommonControls:Localize Advanced}" Command="{Binding ModelSearchFoldersCommand}" Margin="2,0,0,0" ToolTip="{CommonControls:Localize ToolTip_ModelSearchFolders}" ToolTipService.InitialShowDelay="200"/>
                                        </UniformGrid>
                                        <TextBlock Text="{CommonControls:Localize Title_ModelSearchFolders}" VerticalAlignment="Center" Opacity=".7" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    <!--Application-->
                    <Border Style="{StaticResource WizardSection}">
                        <DockPanel>
                            <StackPanel Style="{StaticResource WizardSectionHeader}">
                                <TextBlock Text="{CommonControls:Localize Application}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{CommonControls:Localize GeneralApplicationDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top">
                                <DockPanel>
                                    <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                        <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryTemp, Mode=OneWay}" />
                                        <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveTempDirectoryCommand}" />
                                    </UniformGrid>
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize TempDirectory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding Settings.DirectoryTemp, Mode=OneWay}" IsReadOnly="True" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0" Height="22">
                                    <UniformGrid DockPanel.Dock="Right" Columns="2" Width="304" Margin="4,0,0,0">
                                        <CommonControls:HyperlinkControl Label="{CommonControls:Localize LogDirectory}" Link="{x:Static app:App.DirectoryLogs}" Foreground="{StaticResource DefaultForeground}"  IsButtonType="True" VerticalAlignment="Stretch" Margin="0,0,2,0"/>
                                        <Button Content="{CommonControls:Localize ResetDialogs}" Command="{Binding ResetDialogsCommand}" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                    <CheckBox Content="{CommonControls:Localize CheckForUpdates}" IsChecked="{Binding Settings.IsAutoUpdateEnabled}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!--History-->
                        <Border Style="{StaticResource WizardSection}">
                            <DockPanel>
                                <StackPanel Style="{StaticResource WizardSectionHeader}">
                                    <TextBlock Text="{CommonControls:Localize History}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{CommonControls:Localize GeneralHistoryDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <DockPanel>
                                        <UniformGrid DockPanel.Dock="Right" Columns="2" Width="150" Height="22" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                            <Button Content="{CommonControls:Localize Open}" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding Settings.DirectoryHistory, Mode=OneWay}" />
                                            <Button Content="{CommonControls:Localize Move}" Command="{Binding MoveHistoryDirectoryCommand}" />
                                        </UniformGrid>
                                        <StackPanel>
                                            <TextBlock Text="{CommonControls:Localize Directory}" Style="{StaticResource FieldTextBlockStyle}"/>
                                            <TextBox Text="{Binding Settings.DirectoryHistory, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,6,0,0">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="{CommonControls:Localize Orientation}" Style="{StaticResource FieldTextBlockStyle}"/>
                                            <ComboBox SelectedItem="{Binding Settings.HistoryOrientation, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource Orientation}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="{CommonControls:Localize MaxItems}" Style="{StaticResource FieldTextBlockStyle}"/>
                                            <TextBox Text="{Binding Settings.HistoryItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <CheckBox Content="{CommonControls:Localize AddRecentItems}" IsChecked="{Binding Settings.IsHistoryRecentItemsEnabled}" Margin="4,20,0,0"/>
                                        <CheckBox Content="{CommonControls:Localize SortByLastUsed}" IsChecked="{Binding Settings.IsHistoryAutoSortEnabled}" Margin="4,20,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--Appearance-->
                        <Border Style="{StaticResource WizardSection}">
                            <DockPanel>
                                <StackPanel Style="{StaticResource WizardSectionHeader}">
                                    <TextBlock Text="{CommonControls:Localize Appearance}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{CommonControls:Localize GeneralAppearanceDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <UniformGrid Columns="3" VerticalAlignment="Top">
                                    <StackPanel Margin="0,0,4,0" ToolTip="{CommonControls:Localize ToolTip_Theme}" ToolTipService.InitialShowDelay="200">
                                        <TextBlock Text="{CommonControls:Localize Theme}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource ThemeType}}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" Style="{StaticResource EnumComboBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="{CommonControls:Localize Language}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <CommonControls:LocalizationControl UILanguage="{Binding Settings.UILanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize UIScale}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedValue="{Binding Settings.UIScale, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </StackPanel>
                                </UniformGrid>
                            </DockPanel>
                        </Border>

                        <!--Experimental-->
                        <Border Style="{StaticResource WizardSection}">
                            <DockPanel>
                                <StackPanel Style="{StaticResource WizardSectionHeader}">
                                    <TextBlock Text="{CommonControls:Localize ExperimentalSettings}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{CommonControls:Localize GeneralExperimentalDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <CheckBox Content="{CommonControls:Localize PipelineDebug}" IsChecked="{Binding Settings.IsServerDebugEnabled}" />
                                    <TextBlock Text="{CommonControls:Localize PipelineDebugMessage}" FontSize="11" Opacity=".7" Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!--Access Tokens-->
        <DockPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Style="{StaticResource WizardSection}">
                <StackPanel>
                    <TextBlock Text="{CommonControls:Localize AccessTokens}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{CommonControls:Localize GeneralAccessTokensDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Settings.AccessTokens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Style="{StaticResource FieldTextBlockStyle}">
                                        <Run Text="{Binding Name}"/>
                                        <Run Text="{CommonControls:Localize AccessToken}"/>
                                    </TextBlock>
                                    <Grid>
                                        <TextBox x:Name="TextBoxControl" Text="{Binding Token}" />
                                        <Grid Visibility="{Binding IsFocused, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                            <Grid Visibility="{Binding IsMouseOver, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                                <Grid Visibility="{Binding Text, ElementName=TextBoxControl, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Background="{StaticResource ControlDefaultBackground}">
                                                    <TextBox Text="••••••••••••••••••••••••••••••••••••••••••••••••••••••" FontSize="16" Padding="1,-1,-1,-1" Margin="0"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DockPanel>

    </Grid>
</Views:ViewBase>
