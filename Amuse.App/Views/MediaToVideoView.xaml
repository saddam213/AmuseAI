<Views:ViewBaseDiffusion x:Class="Amuse.App.Views.MediaToVideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MediaToVideoView}}}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="700"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--***Left Panel***-->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="380"/>
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="4">
                    <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">

                        <!--ModelControl-->
                        <Grid DockPanel.Dock="Top" IsEnabled="{Binding GenerateService.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                            <Grid IsEnabled="{Binding GenerateService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                                <Grid IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}}">
                                    <Controls:DiffusionModelControl
                                        x:Name="ModelControl"
                                        ViewType="MediaToVideo"
                                        ProcessType="MediaToVideo"
                                        IsLoraSupported="True"
                                        IsUpscalerSupported="True"
                                        IsExtractorSupported="False"
                                        IsControlNetSupported="False"
                                        Settings="{Binding Settings, Mode=OneWay}" 
                                        IsPipelineLoaded="{Binding IsPipelineLoaded, Mode=OneWay}"
                                        DownloadService="{Binding DownloadService, Mode=OneTime}"
                                        NavigationService="{Binding NavigationService, Mode=OneTime}"
                                        SelectionChanged="SelectedPipelineChanged"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <DockPanel DockPanel.Dock="Bottom">

                            <!--Execute/Cancel-->
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="30" >
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Width="30" Command="{Binding StopCommand}" Visibility="{Binding GenerateService.IsCanceling, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{CommonControls:Localize ToolTip_GenerateStop}" ToolTipService.InitialShowDelay="200">
                                        <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                    </Button>
                                    <Grid IsEnabled="{Binding GenerateService.IsCanceling, Converter={StaticResource InverseBoolConverter}}">
                                        <Button Command="{Binding CancelCommand}" >
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Cancel" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GenerateService.IsCanceling}" Value="True">
                                                            <Setter Property="Content" Value="{CommonControls:Localize Canceling}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DockPanel>
                                <Grid IsEnabled="{Binding IsSelectionValid, ElementName=ModelControl}">
                                    <Button Content="{CommonControls:Localize Generate}" Command="{Binding ExecuteCommand}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Automation}"/>
                                    <Button Content="{CommonControls:Localize Automate}" Command="{Binding ExecuteAutomationCommand}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Automation}"/>
                                </Grid>
                            </UniformGrid>

                            <!--InputControl-->
                            <Grid IsEnabled="{Binding GenerateService.IsLoaded}" >
                                <Controls:DiffusionInputControl 
                                    x:Name="InputControl"
                                    ViewType="MediaToVideo"
                                    ProcessType="MediaToVideo"
                                    Options="{Binding Options, Mode=OneWayToSource}"
                                    UpscaleOptions="{Binding UpscaleOptions, Mode=OneWayToSource}"
                                    AutomationOptions="{Binding AutomationOptions, Mode=OneWayToSource}"
                                    AutomationProgress="{Binding AutomationProgress, Mode=OneWay}"
                                    Pipeline="{Binding CurrentPipeline, Mode=OneWay}" 
                                    IsExecuting="{Binding GenerateService.IsExecuting, Mode=OneWay}"
                                    IsAutomating="{Binding IsAutomating, Mode=OneWay}"
                                    IsImageInputEnabled="False"
                                    IsControlNetEnabled="False"
                                    IsEnabled="{Binding CurrentPipeline, Mode=OneWay, Converter={StaticResource InverseNullBooleanConverter}}"/>
                            </Grid>

                        </DockPanel>
                    </DockPanel>
                </Border>

                <!--References-->
                <Border Grid.Column="1" Margin="4">
                    <DockPanel Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize References}" Style="{StaticResource FieldTextBlockStyle}" />
                        <Grid IsEnabled="{Binding GenerateService.IsLoaded}">
                            <Grid IsEnabled="{Binding GenerateService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                                <Grid IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}}">
                                    <Controls:MediaReferenceControl 
                                        x:Name="ReferenceControl"
                                        ImageMaxCount="{Binding CurrentPipeline.DiffusionModel.DefaultOptions.InputImageMaxCount, Mode=OneWay, FallbackValue=0}"
                                        VideoMaxCount="{Binding CurrentPipeline.DiffusionModel.DefaultOptions.InputVideoMaxCount, Mode=OneWay, FallbackValue=0}"
                                        AudioMaxCount="{Binding CurrentPipeline.DiffusionModel.DefaultOptions.InputAudioMaxCount, Mode=OneWay, FallbackValue=0}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>


            <!--GridSplitter-->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Opacity=".4" Margin="0,20" />


            <!--***Right Panel***-->
            <Grid Grid.Column="2" Grid.Row="0" >

                <!--Content-->
                <DockPanel>

                    <!--Statistics-->
                    <Controls:StatisticsControl 
                        DockPanel.Dock="Bottom"
                        Margin="14,0,14,8"
                        Statistics="{Binding Statistics}"
                        Progress="{Binding Progress}" />

                    <Border Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">

                        <!--Output-->
                        <Grid Margin="10,10,10,2" >
                            <CommonControls:VideoStreamElement 
                                x:Name="ResultControl"
                                SplitterVisibility="Auto"
                                SplitterPosition="Source"
                                SplitterDirection="LeftToRight"
                                IsReplayEnabled="False"
                                IsAutoPlayEnabled="True"
                                IsLoadEnabled="False" 
                                IsLoadOverlayEnabled="False"
                                IsFrameViewerEnabled="True" 
                                Source="{Binding ResultVideo, Mode=TwoWay}" 
                                OverlaySource="{Binding CompareVideo, Mode=TwoWay}" 
                                Volume="{Binding Settings.VolumeOutput, Mode=TwoWay}"
                                IsVolumeMute="{Binding Settings.IsVolumeOutputMute, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </DockPanel>

            </Grid>
        </Grid>

    </Grid>
</Views:ViewBaseDiffusion>
