<Views:ViewBaseLanguage x:Class="Amuse.App.Views.TextInstructView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TextInstructView}}, Mode=OneTime}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="380" MaxWidth="{Binding ActualWidth, Converter={StaticResource DivideByConverter}, ConverterParameter=2, Mode=OneWay}"/>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!--***Left Panel***-->
        <Grid Grid.Column="0">
            <Border Margin="4">
                <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">

                    <!--ModelControl-->
                    <Grid DockPanel.Dock="Top" IsEnabled="{Binding GenerateService.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                        <Grid IsEnabled="{Binding GenerateService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                            <Grid IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                                <Controls:LanguageModelControl
                                    x:Name="ModelControl"
                                    ViewType="TextInstruct"
                                    ProcessType="TextToText"
                                    Settings="{Binding Settings, Mode=OneWay}" 
                                    IsPipelineLoaded="{Binding IsPipelineLoaded, Mode=OneWay}"
                                    DownloadService="{Binding DownloadService, Mode=OneTime}"
                                    NavigationService="{Binding NavigationService, Mode=OneTime}"
                                    SelectionChanged="SelectedPipelineChanged"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <DockPanel DockPanel.Dock="Bottom">

                        <!--InputControl-->
                        <Grid IsEnabled="{Binding GenerateService.IsLoaded, Mode=OneWay}" >
                            <Controls:LanguageInputControl
                                x:Name="InputControl"
                                ViewType="TextInstruct"
                                ProcessType="TextToText"
                                Options="{Binding Options, Mode=OneWayToSource}"
                                AutomationOptions="{Binding AutomationOptions, Mode=OneWayToSource}"
                                AutomationProgress="{Binding AutomationProgress, Mode=OneWay}"
                                Pipeline="{Binding CurrentPipeline, Mode=OneWay}" 
                                IsExecuting="{Binding GenerateService.IsExecuting, Mode=OneWay}"
                                IsAutomating="{Binding IsAutomating, Mode=OneWay}"
                                ToolService="{Binding ToolService, Mode=OneTime}"
                                IsEnabled="{Binding CurrentPipeline, Converter={StaticResource InverseNullBooleanConverter}, Mode=OneWay}"
                                IsInputEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!--GridSplitter-->
        <GridSplitter Grid.Column="1" />

        <!--***Right Panel***-->
        <Grid x:Name="RightPanelContainer" Grid.Column="2" Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="310"/>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="310"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" MinHeight="160" MaxHeight="{Binding ActualHeight, ElementName=RightPanelContainer, Converter={StaticResource SubtractIntConverter}, ConverterParameter=200, Mode=OneWay}"/>
            </Grid.RowDefinitions>

            <!--Content-->
            <Grid>
                <Border IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <Controls:TextResultControl 
                        x:Name="TextResultElement" 
                        Settings="{Binding Settings, Mode=OneWay}"
                        MaxTokenLength="{Binding Options.MaxLength, Mode=OneWay}"
                        IsInputEnabled="{Binding GenerateService.IsExecuting,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                        <Controls:TextResultControl.Style>
                            <Style TargetType="{x:Type Controls:TextResultControl}">
                                <Setter Property="IsMultipleBeamResult" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Options.Beams, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:TextInstructView}}}" Value="1">
                                        <Setter Property="IsMultipleBeamResult" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Controls:TextResultControl.Style>
                    </Controls:TextResultControl>
                </Border>

                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Grid.Row" Value="0"/>
                        <Setter Property="Grid.RowSpan" Value="1"/>
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Setter Property="Margin" Value="6,8,6,6"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleOrientation, Mode=OneWay}" Value="True">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                <Setter Property="Margin" Value="4,8,6,8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <!--GridSplitter-->
            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Visibility="{Binding IsChecked, ElementName=ToggleOrientation, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource GridSplitterHorizontal}" Visibility="{Binding IsChecked, ElementName=ToggleOrientation, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}" />

            <Grid>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" >

                        <!--Execute/Cancel-->
                        <UniformGrid DockPanel.Dock="Right" Columns="2" Width="260" Margin="0,4,0,0">
                            <DockPanel >
                                <Button DockPanel.Dock="Left" Width="30" Command="{Binding StopCommand, Mode=OneWay}" Visibility="{Binding GenerateService.IsCanceling, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" ToolTip="{CommonControls:Localize ToolTip_GenerateStop}" ToolTipService.InitialShowDelay="200">
                                    <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                </Button>
                                <Grid IsEnabled="{Binding GenerateService.IsCanceling, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                                    <Button Command="{Binding CancelCommand, Mode=OneWay}" >
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="Cancel" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GenerateService.IsCanceling, Mode=OneWay}" Value="True">
                                                        <Setter Property="Content" Value="{CommonControls:Localize Canceling}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DockPanel>
                            <Grid IsEnabled="{Binding IsSelectionValid, ElementName=ModelControl, Mode=OneWay}">
                                <Button Content="{CommonControls:Localize Generate}" Command="{Binding ExecuteCommand, Mode=OneWay}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Automation, Mode=OneWay}"/>
                                <Button Content="{CommonControls:Localize Automate}" Command="{Binding ExecuteAutomationCommand, Mode=OneWay}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Automation, Mode=OneWay}"/>
                            </Grid>
                        </UniformGrid>

                        <DockPanel DockPanel.Dock="Bottom">
                            <!--Orientation-->
                            <CommonControls:ToggleButton 
                                x:Name="ToggleOrientation" 
                                Margin="0,4,0,0"
                                DockPanel.Dock="Left"
                                IconTrue="e80f"
                                IconFalse="e793" 
                                ColorTrue="{StaticResource DefaultForeground}"
                                ColorFalse="{StaticResource DefaultForeground}"
                                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay}" />

                            <!--Statistics-->
                            <Controls:StatisticsControl 
                                Margin="10,0,10,1"
                                PrefixPerSecond="tokens/s"
                                PrefixSecondsPer=""
                                Statistics="{Binding Statistics, Mode=OneWay}"
                                Progress="{Binding Progress, Mode=OneWay}"/>
                        </DockPanel>

                    </DockPanel>

                    <!--Input Text-->
                    <Border Style="{StaticResource TextDropZoneStyle}" Margin="0,0,0,1" IsEnabled="{Binding IsPipelineLoaded, Mode=OneWay}">
                        <Grid>
                            <CommonControls:PlaceholderTextBox 
                                Text="{Binding Options.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                TextPadding="2,2,2,10" 
                                AcceptsReturn="True" 
                                TextWrapping="Wrap" 
                                PreviewKeyDown="OnSourceTextKeyDown"
                                Placeholder="Please ask a question..." 
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsAutomating, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"/>
                            <TextBox 
                                Text="{Binding AutomationPrompt, Mode=OneWay}" 
                                Padding="2,2,2,10" 
                                IsReadOnly="True" 
                                TextWrapping="Wrap" 
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsAutomating, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                </DockPanel>

                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Grid.Row" Value="2"/>
                        <Setter Property="Grid.RowSpan" Value="1"/>
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Setter Property="Margin" Value="6,6,6,8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleOrientation, Mode=OneWay}" Value="True">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="3"/>
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                <Setter Property="Margin" Value="6,8,4,8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </Grid>
    </Grid>
</Views:ViewBaseLanguage>
