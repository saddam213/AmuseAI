<Views:ViewBaseLanguage x:Class="Amuse.App.Views.ImageToTextView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Amuse.App.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Amuse.App.Controls"
    xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
    xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ImageToTextView}}, Mode=OneTime}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="380" MaxWidth="{Binding ActualWidth, Converter={StaticResource DivideByConverter}, ConverterParameter=2, Mode=OneWay}"/>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!--***Left Panel***-->
        <Grid Grid.Column="0">
            <Border Margin="4">
                <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">

                    <!--ModelControl-->
                    <Grid DockPanel.Dock="Top" IsEnabled="{Binding GenerateService.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                        <Grid IsEnabled="{Binding GenerateService.IsExecuting, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                            <Grid IsEnabled="{Binding IsAutomating, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                                <Controls:LanguageModelControl
                                    x:Name="ModelControl"
                                    ViewType="ImageToText"
                                    ProcessType="ImageToText"
                                    Settings="{Binding Settings, Mode=OneWay}" 
                                    IsPipelineLoaded="{Binding IsPipelineLoaded, Mode=OneWay}"
                                    DownloadService="{Binding DownloadService, Mode=OneTime}"
                                    NavigationService="{Binding NavigationService, Mode=OneTime}"
                                    SelectionChanged="SelectedPipelineChanged"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <DockPanel DockPanel.Dock="Bottom">

                        <!--Execute/Cancel-->
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="30" >
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Width="30" Command="{Binding StopCommand, Mode=OneWay}" Visibility="{Binding GenerateService.IsCanceling, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" ToolTip="{CommonControls:Localize ToolTip_GenerateStop}" ToolTipService.InitialShowDelay="200">
                                    <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                </Button>
                                <Grid IsEnabled="{Binding GenerateService.IsCanceling, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                                    <Button Command="{Binding CancelCommand, Mode=OneWay}" >
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="Cancel" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GenerateService.IsCanceling, Mode=OneWay}" Value="True">
                                                        <Setter Property="Content" Value="{CommonControls:Localize Canceling}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DockPanel>
                            <Grid IsEnabled="{Binding IsSelectionValid, ElementName=ModelControl, Mode=OneWay}">
                                <Button Content="{CommonControls:Localize Generate}" Command="{Binding ExecuteCommand, Mode=OneWay}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Automation, Mode=OneWay}"/>
                                <Button Content="{CommonControls:Localize Automate}" Command="{Binding ExecuteAutomationCommand, Mode=OneWay}" Visibility="{Binding SelectedOption, ElementName=InputControl, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Automation, Mode=OneWay}"/>
                            </Grid>
                        </UniformGrid>

                        <!--InputControl-->
                        <Grid IsEnabled="{Binding GenerateService.IsLoaded, Mode=OneWay}" >
                            <Controls:LanguageInputControl 
                                x:Name="InputControl"
                                ViewType="ImageToText"
                                ProcessType="ImageToText"
                                DefaultPrompt="Describe the Image."
                                IsPromptEnabled="True"
                                IsInputImagesEnabled="True"
                                Options="{Binding Options, Mode=OneWayToSource}"
                                AutomationOptions="{Binding AutomationOptions, Mode=OneWayToSource}"
                                AutomationProgress="{Binding AutomationProgress, Mode=OneWay}"
                                Pipeline="{Binding CurrentPipeline, Mode=OneWay}" 
                                IsExecuting="{Binding GenerateService.IsExecuting, Mode=OneWay}"
                                IsAutomating="{Binding IsAutomating, Mode=OneWay}"
                                ToolService="{Binding ToolService, Mode=OneTime}"
                                IsEnabled="{Binding CurrentPipeline, Converter={StaticResource InverseNullBooleanConverter}, Mode=OneWay}"/>
                        </Grid>

                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!--GridSplitter-->
        <GridSplitter Grid.Column="1" />

        <!--***Right Panel***-->
        <Grid x:Name="RightPanelContainer" Grid.Column="2" >

            <!--Content-->
            <DockPanel >

                <!--Statistics-->
                <Controls:StatisticsControl 
                    DockPanel.Dock="Bottom"
                    Margin="8,0,8,8"
                    PrefixPerSecond="tokens/s"
                    PrefixSecondsPer=""
                    Statistics="{Binding Statistics, Mode=OneWay}"
                    Progress="{Binding Progress, Mode=OneWay}" />
                <Border IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="160"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1*" MinWidth="160"/>
                        </Grid.ColumnDefinitions>

                        <!--Inputs-->
                        <Grid Margin="8,8,8,2" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <!--SourceImage1-->
                            <Grid>
                                <CommonControls:ImageElement 
                                    SplitterVisibility="Auto"
                                    SplitterPosition="Source"
                                    SplitterDirection="LeftToRight"
                                    IsLoadEnabled="True" 
                                    IsSaveEnabled="False"
                                    IsLoadOverlayEnabled="False" 
                                    CropWidth="{Binding Options.Width, Mode=OneWay}"
                                    CropHeight="{Binding Options.Height, Mode=OneWay}"
                                    Source="{Binding SourceImage1, Mode=TwoWay}" 
                                    IsInputEnabled="{Binding IsPipelineLoaded, Mode=OneWay}"
                                    OnMediaImport="OnMediaImport"
                                    Title="Image 1"/>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Options.IsSource1Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                                <Setter Property="Grid.RowSpan" Value="2"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource2Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Grid.RowSpan" Value="1"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource3Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Grid.RowSpan" Value="1"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource4Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Margin" Value="0,0,4,4"/>
                                                <Setter Property="Grid.RowSpan" Value="1"/>
                                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedOption, Mode=OneWay, ElementName=InputControl, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automation}" Value="True"/>
                                                    <Condition Binding="{Binding AutomationOptions.Type, Mode=OneWay, ElementName=InputControl, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=InputFiles}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>

                            <!--SourceImage2-->
                            <Grid >
                                <CommonControls:ImageElement 
                                    SplitterVisibility="Auto"
                                    SplitterPosition="Source"
                                    SplitterDirection="LeftToRight"
                                    IsLoadEnabled="True" 
                                    IsSaveEnabled="False"
                                    IsLoadOverlayEnabled="False" 
                                    CropWidth="{Binding Options.Width, Mode=OneWay}"
                                    CropHeight="{Binding Options.Height, Mode=OneWay}"
                                    Source="{Binding SourceImage2, Mode=TwoWay}" 
                                    IsInputEnabled="{Binding IsPipelineLoaded, Mode=OneWay}"
                                    OnMediaImport="OnMediaImport"
                                    Title="Image 2"/>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Options.IsSource2Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Margin" Value="0,4,0,0"/>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource3Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Margin" Value="0,4,4,0"/>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource4Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Margin" Value="4,0,0,4"/>
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.Column" Value="1"/>
                                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>

                            <!--SourceImage3-->
                            <Grid >
                                <CommonControls:ImageElement 
                                    SplitterVisibility="Auto"
                                    SplitterPosition="Source"
                                    SplitterDirection="LeftToRight" 
                                    IsLoadEnabled="True" 
                                    IsSaveEnabled="False"
                                    IsLoadOverlayEnabled="False"
                                    CropWidth="{Binding Options.Width, Mode=OneWay}"
                                    CropHeight="{Binding Options.Height, Mode=OneWay}"
                                    Source="{Binding SourceImage3, Mode=TwoWay}" 
                                    IsInputEnabled="{Binding IsPipelineLoaded, Mode=OneWay}"
                                    OnMediaImport="OnMediaImport"
                                    Title="Image 3"/>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Options.IsSource3Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Margin" Value="4,4,0,0"/>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.IsSource4Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Margin" Value="0,4,4,0"/>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>

                            <!--SourceImage4-->
                            <Grid >
                                <CommonControls:ImageElement 
                                   SplitterVisibility="Auto"
                                   SplitterPosition="Source"
                                   SplitterDirection="LeftToRight" 
                                   IsLoadEnabled="True" 
                                   IsSaveEnabled="False"
                                   IsLoadOverlayEnabled="False"
                                   CropWidth="{Binding Options.Width, Mode=OneWay}"
                                   CropHeight="{Binding Options.Height, Mode=OneWay}"
                                   Source="{Binding SourceImage4, Mode=TwoWay}" 
                                   IsInputEnabled="{Binding IsPipelineLoaded, Mode=OneWay}"
                                   OnMediaImport="OnMediaImport"
                                   Title="Image 4"/>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Grid.Row" Value="1"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Margin" Value="4,4,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Options.IsSource4Enabled, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>

                        </Grid>

                        <!--GridSplitter-->
                        <GridSplitter Grid.Column="1" />

                        <!--Result-->
                        <Grid Grid.Column="2">
                            <Grid Margin="8,8,8,2" >
                                <Controls:TextResultControl 
                                    x:Name="TextResultElement" 
                                    Settings="{Binding Settings, Mode=OneWay}"
                                    MaxTokenLength="{Binding Options.MaxLength, Mode=OneWay}"
                                    IsInputEnabled="{Binding GenerateService.IsExecuting,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                                    <Controls:TextResultControl.Style>
                                        <Style TargetType="{x:Type Controls:TextResultControl}">
                                            <Setter Property="IsMultipleBeamResult" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Options.Beams, RelativeSource={RelativeSource AncestorType={x:Type local:ImageToTextView}}, Mode=OneWay}" Value="1">
                                                    <Setter Property="IsMultipleBeamResult" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Controls:TextResultControl.Style>
                                </Controls:TextResultControl>
                            </Grid>
                        </Grid>

                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Views:ViewBaseLanguage>
