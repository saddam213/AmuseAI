<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.McpServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="760"
        MaxWidth="760"
        MinHeight="360"
        Title="{CommonControls:Localize Title_McpServer}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:McpServerDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <StackPanel>

            <!--Server-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize McpServer}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize McpServerDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Name}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="{CommonControls:Localize McpConnection}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource McpTransportType}}" SelectedItem="{Binding Transport}" Style="{StaticResource EnumComboBox}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{CommonControls:Localize McpIcon}" Style="{StaticResource FieldTextBlockStyle}" Margin="0,4,0,0"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Width="70" Margin="6,0,0,0" VerticalAlignment="Top">
                                <Border Background="{StaticResource ButtonBackgroundDisabled}" Height="44">
                                    <CommonControls:FontAwesome Icon="{Binding IconPreview}" Size="24" Color="{StaticResource ToggleIconOnColour}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Text="{Binding ServerIcon, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" HorizontalContentAlignment="Center" Margin="0,2,0,0" ToolTip="{CommonControls:Localize ToolTip_McpIconCode}" ToolTipService.InitialShowDelay="200"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Icons}" SelectedItem="{Binding ServerIcon, Mode=TwoWay}" ItemContainerStyle="{StaticResource TransparentListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="IconBorder" Width="24" Height="22" Margin="0,0,1,1" Background="{StaticResource ButtonBackgroundDisabled}" BorderThickness="1" BorderBrush="Transparent">
                                            <CommonControls:FontAwesome Icon="{Binding}" Size="13" Color="{StaticResource DefaultForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{StaticResource InfoColour}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Command-->
            <Border Style="{StaticResource WizardSection}" Visibility="{Binding IsStdio, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize McpCommand}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize McpCommandDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{CommonControls:Localize McpCommand}" Style="{StaticResource FieldTextBlockStyle}"/>
                        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{CommonControls:Localize McpArguments}" Style="{StaticResource FieldTextBlockStyle}" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Url-->
            <Border Style="{StaticResource WizardSection}" Visibility="{Binding IsStdio, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize McpUrl}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize McpUrlDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{CommonControls:Localize McpUrl}" Style="{StaticResource FieldTextBlockStyle}"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Variables-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{Binding VariablesTitle}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize McpVariablesDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <DockPanel Height="22">
                            <Button DockPanel.Dock="Right" Content="{CommonControls:Localize Add}" Command="{Binding AddVariableCommand}" Width="100" />
                            <UniformGrid Columns="2" Margin="0,0,32,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{CommonControls:Localize Name}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="{CommonControls:Localize Value}" Style="{StaticResource FieldTextBlockStyle}" Margin="2,0,0,0"/>
                            </UniformGrid>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110" Margin="0,2,0,0">
                            <ItemsControl ItemsSource="{Binding Variables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <Button DockPanel.Dock="Right" Command="{Binding RemoveVariableCommand, RelativeSource={RelativeSource AncestorType={x:Type local:McpServerDialog}}}" CommandParameter="{Binding}" Style="{StaticResource TransparentButton}" Width="28">
                                                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                            </Button>
                                            <UniformGrid Columns="2">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <Grid Margin="2,0,0,0">
                                                    <TextBox x:Name="TextBoxControl" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Grid Visibility="{Binding IsFocused, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                                        <Grid Visibility="{Binding IsMouseOver, ElementName=TextBoxControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsHitTestVisible="False">
                                                            <Grid Visibility="{Binding Text, ElementName=TextBoxControl, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Background="{StaticResource ControlDefaultBackground}">
                                                                <TextBox Text="••••••••••••••••••••••••••••••••••••••••••••••••••••••" FontSize="16" Padding="1,-1,-1,-1" Margin="0"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </UniformGrid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Tools-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Tools}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize McpToolsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <DockPanel Height="22">
                            <Button DockPanel.Dock="Right" Content="{CommonControls:Localize McpTest}" Command="{Binding TestCommand}" Width="100" ToolTip="{CommonControls:Localize ToolTip_McpTest}" ToolTipService.InitialShowDelay="200"/>
                            <TextBlock Text="{Binding TestMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity=".8" Margin="0,0,6,0" ToolTip="{Binding TestMessage}" ToolTipService.InitialShowDelay="200"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsIncluded}" Margin="0,2" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="200">
                                            <TextBlock Text="{Binding Name}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</CommonControls:DialogControl>
