<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.ComponentModelWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        Title="{CommonControls:Localize Title_AddComponent}"
        MinWidth="800"
        MaxWidth="800"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ComponentModelWizardDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Main Content-->
        <StackPanel>

            <!--Model-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Model}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize ComponentWizardModelDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{CommonControls:Localize Type}" Style="{StaticResource FieldTextBlockStyle}"/>
                        <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Source-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Source}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize WizardFileSourceDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <Controls:CheckpointControl Margin="-4" Settings="{Binding Settings}" Checkpoint="{Binding Checkpoint}" SupportedTypes="{Binding CheckpointTypes, Mode=OneWay}" FileFilter="{Binding FileFilter}">
                            <Controls:CheckpointControl.Style>
                                <Style TargetType="{x:Type Controls:CheckpointControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Checkpoint.Type}" Value="OnlineFile">
                                            <Setter Property="Height" Value="150"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Checkpoint.Type}" Value="OnlineFolder">
                                            <Setter Property="Height" Value="195"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Controls:CheckpointControl.Style>
                        </Controls:CheckpointControl>
                        <TextBlock Text="{CommonControls:Localize WizardDownloadLinkHint}" Margin="0,2,0,0" FontSize="10" Opacity=".7" TextWrapping="Wrap" Visibility="{Binding Checkpoint.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=OnlineFolder|OnlineFile}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Name-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Component}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize ComponentWizardKeyHint}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <UniformGrid Columns="2" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="{CommonControls:Localize ModelName}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding SelectedName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="{CommonControls:Localize Key}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding SelectedKey, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                        </StackPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

        </StackPanel>

    </DockPanel>
</CommonControls:DialogControl>
