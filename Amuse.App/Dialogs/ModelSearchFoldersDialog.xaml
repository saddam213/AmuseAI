<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.ModelSearchFoldersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="760"
        MaxWidth="760"
        MinHeight="360"
        Title="{CommonControls:Localize Title_ModelSearchFolders}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ModelSearchFoldersDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Description-->
        <Border DockPanel.Dock="Top" Style="{StaticResource WizardSection}">
            <DockPanel>
                <CommonControls:FontAwesome DockPanel.Dock="Left" Icon="f071" Size="14" Color="{StaticResource WarningColour}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock Text="{CommonControls:Localize ModelSearchFoldersMessage}" TextWrapping="Wrap" FontSize="11" />
            </DockPanel>
        </Border>

        <!--Add-->
        <DockPanel DockPanel.Dock="Top" Height="22" Margin="0,10,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" Width="300" >
                <Button Content="{CommonControls:Localize ModelSearchFoldersComfyUI}" Command="{Binding AddComfyUICommand}" />
                <Button Content="{CommonControls:Localize Add}" Command="{Binding AddCommand}" />
            </UniformGrid>
            <TextBlock />
        </DockPanel>

        <!--Headers-->
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{CommonControls:Localize ModelType}" Style="{StaticResource FieldTextBlockStyle}" Width="134" />
            <TextBlock Text="{CommonControls:Localize Folder}" Style="{StaticResource FieldTextBlockStyle}" />
        </DockPanel>

        <!--Search Folders-->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
            <ItemsControl ItemsSource="{Binding SearchPaths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4" Height="25">
                            <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ModelSearchFoldersDialog}}}" CommandParameter="{Binding}" Style="{StaticResource TransparentButton}" Width="28">
                                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ModelSearchFoldersDialog}}}" CommandParameter="{Binding}" Padding="15,0">
                                <StackPanel Orientation="Horizontal">
                                    <CommonControls:FontAwesome Icon="f002" Size="12" />
                                    <TextBlock Text="{CommonControls:Localize Browse}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Source={StaticResource ModelFolderType}}" SelectedItem="{Binding Folder}" Style="{StaticResource EnumComboBox}" Width="130" Margin="0,0,4,0" />
                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</CommonControls:DialogControl>
