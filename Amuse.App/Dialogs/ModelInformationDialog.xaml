<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.ModelInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        xmlns:Common="clr-namespace:Amuse.App.Common"
        mc:Ignorable="d"
        MinWidth="800"
        MaxWidth="800"
        MaxHeight="800"
        Title="{CommonControls:Localize Title_ModelFiles}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ModelInformationDialog}}}" Margin="15, 15, 15, 10">

        <!--Close-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <Button DockPanel.Dock="Right" Content="{CommonControls:Localize Close}" Command="{Binding CloseCommand}" Width="100" IsDefault="True" IsCancel="True"/>
            <TextBlock />
        </DockPanel>

        <!--Model-->
        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding DownloadModel.Status, Converter={StaticResource EnumDisplayNameConverter}}" FontWeight="DemiBold" FontSize="14" Style="{StaticResource ModelStatusTextBlock}" Tag="{Binding DownloadModel.Status}" ToolTipService.InitialShowDelay="200"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding DownloadModel.Name}" FontSize="16" FontWeight="DemiBold" />
                <CommonControls:HyperlinkControl Link="{Binding DownloadModel.Link}" Label="{Binding DownloadModel.Link}" FontSize="13" Foreground="DeepSkyBlue" Margin="1,0,0,0" Visibility="{Binding DownloadModel.Link, Converter={StaticResource NullOrEmptyVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>

        <!--Files-->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type Common:ModelInformationItem}">
                        <Grid>

                            <!--Quality Set-->
                            <TextBlock Text="{Binding Heading}" FontSize="14" FontWeight="DemiBold" Margin="2,8,0,2" Visibility="{Binding IsHeading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!--Model Part-->
                            <Border Style="{StaticResource WizardSection}" Visibility="{Binding IsHeading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Source}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplayNameConverter}}" FontSize="11" Margin="0,2,0,0" Style="{StaticResource ModelStatusTextBlock}" Tag="{Binding Status}" ToolTipService.InitialShowDelay="200" Visibility="{Binding Status, Converter={StaticResource NullVisibilityConverter}}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Files}" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="11" Padding="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</CommonControls:DialogControl>
