<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.UpscaleModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        MinWidth="800"
        MaxWidth="800"
        Title="{CommonControls:Localize Title_UpscaleModel}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:UpscaleModelDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Main Content-->
        <StackPanel>

            <!--Model-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Model}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize UpscaleModelDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <UniformGrid Rows="1">
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Backend}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding UpscaleModel.Backend}" IsEnabled="{Binding UpscaleModel.IsVideoUpscaler, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="2,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Pipeline}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Settings.Pipelines}" SelectedItem="{Binding UpscaleModel.Pipeline}" IsEnabled="False" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="{CommonControls:Localize ModelName}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox Text="{Binding UpscaleModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{CommonControls:Localize ModelLink}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding UpscaleModel.Link, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Settings-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Settings}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize ModelSettingsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <UniformGrid Columns="3" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="{CommonControls:Localize ScaleFactor}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding UpscaleModel.ScaleFactor, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="2,0,2,0">
                            <TextBlock Text="{CommonControls:Localize MemorySize}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding UpscaleModel.MemorySize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0" Visibility="{Binding UpscaleModel.Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=OnnxRuntime}">
                            <TextBlock Text="{CommonControls:Localize SampleSize}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding UpscaleModel.SampleSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,2,0" Visibility="{Binding UpscaleModel.Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=OnnxRuntime}">
                            <TextBlock Text="{CommonControls:Localize InputNormalization}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource NormalizationType}}" SelectedItem="{Binding UpscaleModel.Normalization}" SelectedIndex="0" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="2,4,2,0" Visibility="{Binding UpscaleModel.Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=OnnxRuntime}">
                            <TextBlock Text="{CommonControls:Localize OutputNormalization}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource NormalizationType}}" SelectedItem="{Binding UpscaleModel.OutputNormalization}" SelectedIndex="0" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!--Defaults-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Options}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize ModelOptionsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">

                        <!--Image Upscalers-->
                        <UniformGrid Columns="3" Visibility="{Binding UpscaleModel.IsVideoUpscaler, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,0,2,0">
                                <CheckBox Content="{CommonControls:Localize EnableTiling}" IsChecked="{Binding UpscaleModel.DefaultOptions.IsTileEnabled}" Margin="0,19,0,0"/>
                            </StackPanel>
                            <StackPanel IsEnabled="{Binding UpscaleModel.DefaultOptions.IsTileEnabled}" Margin="2,0,2,0">
                                <TextBlock Text="{CommonControls:Localize TileSize}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding UpscaleModel.DefaultOptions.TileSize}" />
                            </StackPanel>
                            <StackPanel IsEnabled="{Binding UpscaleModel.DefaultOptions.IsTileEnabled}" Margin="2,0,0,0" Visibility="{Binding UpscaleModel.Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=OnnxRuntime}">
                                <TextBlock Text="{CommonControls:Localize TileOverlap}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding UpscaleModel.DefaultOptions.TileOverlap}" />
                            </StackPanel>
                        </UniformGrid>

                        <!--Video Upscalers-->
                        <UniformGrid Columns="3" Visibility="{Binding UpscaleModel.IsVideoUpscaler, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,0,2,0" ToolTip="{CommonControls:Localize ToolTip_UpscaleSeed}" ToolTipService.InitialShowDelay="200">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding UpscaleModel.DefaultOptions.Seed}" />
                            </StackPanel>
                            <StackPanel Margin="2,0,2,0" Visibility="{Binding UpscaleModel.Pipeline, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SeedVR2Pipeline}" ToolTip="{CommonControls:Localize ToolTip_UpscaleTemporalChunkSize}" ToolTipService.InitialShowDelay="200">
                                <TextBlock Text="{CommonControls:Localize UpscaleTemporalChunkSize}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding UpscaleModel.DefaultOptions.TemporalChunkSize}" />
                            </StackPanel>
                            <StackPanel Margin="2,0,2,0" Visibility="{Binding UpscaleModel.Pipeline, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=RelayVSRPipeline}" ToolTip="{CommonControls:Localize ToolTip_UpscaleWindowSize}" ToolTipService.InitialShowDelay="200">
                                <TextBlock Text="{CommonControls:Localize UpscaleWindowSize}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding UpscaleModel.DefaultOptions.WindowSize}" />
                            </StackPanel>
                        </UniformGrid>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!--File-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Upscaler}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize ModelFileDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <Controls:CheckpointControl Margin="-4" Settings="{Binding Settings}" Checkpoint="{Binding UpscaleModel.Checkpoint}" SupportedTypes="{Binding CheckpointTypes, Mode=OneWay}" FileFilter="{Binding FileFilter, Mode=OneWay}">
                            <Controls:CheckpointControl.Style>
                                <Style TargetType="{x:Type Controls:CheckpointControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpscaleModel.Checkpoint.Type}" Value="OnlineFile">
                                            <Setter Property="Height" Value="150"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Controls:CheckpointControl.Style>
                        </Controls:CheckpointControl>

                        <!--VAE, video upscalers-->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding UpscaleModel.IsVideoUpscaler, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{CommonControls:Localize AutoEncoder}" FontWeight="SemiBold"/>
                            <Controls:CheckpointControl Margin="-4" Settings="{Binding Settings}" Checkpoint="{Binding UpscaleModel.Vae}" SupportedTypes="{Binding VaeCheckpointTypes, Mode=OneWay}" FileFilter="{Binding FileFilter, Mode=OneWay}">
                                <Controls:CheckpointControl.Style>
                                    <Style TargetType="{x:Type Controls:CheckpointControl}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpscaleModel.Vae.Type}" Value="OnlineFile">
                                                <Setter Property="Height" Value="150"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Controls:CheckpointControl.Style>
                            </Controls:CheckpointControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</CommonControls:DialogControl>
