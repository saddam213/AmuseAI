<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.CheckpointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="500"
        MaxWidth="500"
        x:Name="UI"
        Title="{CommonControls:Localize Title_QuantDownload}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding ElementName=UI}" Margin="15, 15, 15, 10">

        <!--Download / Cancel-->
        <Grid DockPanel.Dock="Bottom" Margin="0,15,0,0">
            <UniformGrid Columns="2" Height="30" HorizontalAlignment="Right">
                <Button Content="{CommonControls:Localize Download}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}" Width="100"/>
            </UniformGrid>
        </Grid>

        <DockPanel>
            <CommonControls:FontAwesome DockPanel.Dock="Left" Size="50" Margin="0,5,0,20" Icon="f0ed" IconStyle="Light" Color="{StaticResource InfoColour}" VerticalAlignment="Top" />
            <StackPanel Margin="20,2,0,0">

                <!--Title-->
                <TextBlock Text="{Binding Message}" FontSize="16" TextWrapping="Wrap" />

                <!--Message-->
                <TextBlock Text="{CommonControls:Localize QuantDownloadSubMessage}" Margin="0,3,0,0" FontStyle="Italic" FontSize="11" Opacity=".8" TextWrapping="Wrap" Visibility="{Binding IsSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--Checkpoint Sets-->
                <ListBox x:Name="CheckpointListBox" Margin="0,10,0,10" ItemsSource="{Binding Checkpoints}" SelectedItem="{Binding SelectedCheckpoint}" HorizontalContentAlignment="Stretch" Visibility="{Binding IsSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Margin="4,4">
                                <StackPanel Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MemorySize, StringFormat={}{0:0.#}GB}" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" Opacity=".6"/>
                                        <TextBlock Text="{CommonControls:Localize Installed}" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SuccessColour}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding QualityDescription}" Margin="0,1,0,0" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </DockPanel>

    </DockPanel>
</CommonControls:DialogControl>
