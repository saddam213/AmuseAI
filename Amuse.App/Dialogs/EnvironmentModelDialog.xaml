<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.EnvironmentModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="900"
        MaxWidth="900"
        Title="{CommonControls:Localize Title_Environment}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:EnvironmentModelDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" MinHeight="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" Height="30" VerticalAlignment="Bottom">
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Main Content-->
        <StackPanel>

            <!--Environment-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Environment}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize EnvironmentSectionDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top" IsEnabled="{Binding IsFixedEnvironment, Converter={StaticResource InverseBoolConverter}}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Name}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox Text="{Binding EnvironmentModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="{CommonControls:Localize EnvironmentFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox Text="{Binding EnvironmentModel.Environment, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel Margin="0,4,0,0">
                            <CheckBox DockPanel.Dock="Right" Content="{CommonControls:Localize Default_}" IsChecked="{Binding EnvironmentModel.IsDefault}" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize Description}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox Text="{Binding EnvironmentModel.Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--Runtime-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize EnvironmentRuntime}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize EnvironmentRuntimeDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <UniformGrid Columns="3" VerticalAlignment="Top" IsEnabled="{Binding IsFixedEnvironment, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Margin="0,0,4,4" Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{CommonControls:Localize Backend}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource BackendType}}" SelectedItem="{Binding BackendType}" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4" Visibility="{Binding HostVersions.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <TextBlock Text="{CommonControls:Localize Version}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox SelectedItem="{Binding EnvironmentModel.HostVersion}" ItemsSource="{Binding HostVersions}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4">
                            <TextBlock Text="{CommonControls:Localize Vendor}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource VendorType}}" SelectedItem="{Binding EnvironmentModel.Vendor}" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4">
                            <TextBlock Text="{CommonControls:Localize Type}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource EnvironmentType}}" SelectedItem="{Binding EnvironmentModel.Type}" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4" Visibility="{Binding EnvironmentModel.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Device}">
                            <TextBlock Text="{CommonControls:Localize Device}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Settings.Devices}" SelectedValue="{Binding EnvironmentModel.Device}" DisplayMemberPath="Name" SelectedValuePath="HardwareID" SelectedIndex="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4" Visibility="{Binding EnvironmentModel.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pipeline}">
                            <TextBlock Text="{CommonControls:Localize Pipeline}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding Settings.DiffusionPipelines}" SelectedItem="{Binding EnvironmentModel.Pipeline}" SelectedIndex="0" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,4,4">
                            <TextBlock Text="{CommonControls:Localize DownloadSizeGB}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding EnvironmentModel.DownloadSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!--Requirements-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Requirements}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize EnvironmentRequirementsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Text="{Binding Requirements, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsEnabled="{Binding IsFixedEnvironment, Converter={StaticResource InverseBoolConverter}}"/>
                </DockPanel>
            </Border>

            <!--Variables-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize EnvironmentVariables}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize EnvironmentVariablesDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel VerticalAlignment="Top">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Command="{Binding AddVariableCommand}" Height="22" Width="40" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,2,0">
                                    <TextBlock Text="{CommonControls:Localize Name}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding CurrentVariable.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <TextBlock Text="{CommonControls:Localize Value}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding CurrentVariable.Value, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Variables}" SelectedItem="{Binding SelectedVariable}" ItemContainerStyle="{StaticResource TransparentListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0" Background="Transparent" BorderThickness="0" MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ButtonBackgroundDisabled}" Margin="0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding RemoveVariableCommand, RelativeSource={RelativeSource AncestorType={x:Type local:EnvironmentModelDialog}}}" CommandParameter="{Binding}" Style="{StaticResource TransparentButton}" Width="28">
                                                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                            </Button>
                                            <UniformGrid Columns="2">
                                                <TextBlock Text="{Binding Name}" Margin="4,3,2,3" />
                                                <TextBlock Text="{Binding Value}" Margin="4,3,2,3" />
                                            </UniformGrid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</CommonControls:DialogControl>
