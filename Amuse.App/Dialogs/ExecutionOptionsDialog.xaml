<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.ExecutionOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        MinWidth="760"
        MaxWidth="760"
        Title="{CommonControls:Localize Title_ExecutionOptions}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ExecutionOptionsDialog}}}" Margin="15, 15, 15, 10">

        <!--Reset/Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" MinHeight="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" Height="30" VerticalAlignment="Bottom">
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <Button DockPanel.Dock="Left" Content="{CommonControls:Localize Reset}" Command="{Binding ResetCommand}" Width="100" Height="30" VerticalAlignment="Bottom" ToolTip="{CommonControls:Localize ToolTip_ResetExecutionOptions}" ToolTipService.InitialShowDelay="200"/>
            <ItemsControl ItemsSource="{Binding Errors}" Margin="10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Main Content-->
        <StackPanel>

                <!--LlamaCpp-->
                <StackPanel Visibility="{Binding Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=LlamaCpp}">
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize Memory}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionMemoryDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Top">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{CommonControls:Localize Threads}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding ExecutionOptions.Threads, UpdateSourceTrigger=PropertyChanged}" ToolTip="{CommonControls:Localize ToolTip_Threads}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{CommonControls:Localize GpuLayers}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding ExecutionOptions.GpuLayers, UpdateSourceTrigger=PropertyChanged}" ToolTip="{CommonControls:Localize ToolTip_GpuLayers}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize ContextSize}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding ExecutionOptions.ContextSize, UpdateSourceTrigger=PropertyChanged}" ToolTip="{CommonControls:Localize ToolTip_ContextSize}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom"/>
                                </StackPanel>
                            </UniformGrid>
                            <CheckBox Content="{CommonControls:Localize CacheOffload}" IsChecked="{Binding ExecutionOptions.IsCacheOffloadEnabled}" ToolTip="{CommonControls:Localize ToolTip_CacheOffload}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize FlashAttention}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionFlashAttentionDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Columns="3" VerticalAlignment="Top">
                            <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.TextEncoderFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                        </UniformGrid>
                    </DockPanel>
                </Border>
                </StackPanel>

                <!--StableDiffusionCpp-->
                <StackPanel Visibility="{Binding Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=StableDiffusionCpp}">
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize Memory}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionMemoryDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Top">
                            <UniformGrid Columns="2">
                                <StackPanel>
                                <TextBlock Text="{CommonControls:Localize WeightType}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding WeightTypes}" SelectedItem="{Binding ExecutionOptions.WeightType}" Style="{StaticResource EnumComboBox}" ToolTip="{CommonControls:Localize ToolTip_WeightType}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom"/>
                            </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{CommonControls:Localize MemoryReserveGB}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding ExecutionOptions.MemoryReserve, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox Content="{CommonControls:Localize SegmentPrefetch}" IsChecked="{Binding ExecutionOptions.IsPrefetchEnabled}" Margin="0,0,20,0"/>
                                <CheckBox Content="{CommonControls:Localize SegmentedCompute}" IsChecked="{Binding ExecutionOptions.IsSegmentedComputeEnabled}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize FlashAttention}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionFlashAttentionDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Top">
                            <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize AllParts}" Style="{StaticResource FieldTextBlockStyle}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding SelectedFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize Diffusion}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.DiffusionFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize AutoEncoder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.AutoEncoderFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize TextEncoder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.TextEncoderFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize ControlNet}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.ControlNetFlashAttention}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            </UniformGrid>
                            <CheckBox Content="{CommonControls:Localize EnableSageAttention}" IsChecked="{Binding ExecutionOptions.IsSageAttentionEnabled}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize ConvDirect}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionConvDirectDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Columns="5" VerticalAlignment="Top">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize AllParts}" Style="{StaticResource FieldTextBlockStyle}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding SelectedConvDirect}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize Diffusion}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.DiffusionConvDirect}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize AutoEncoder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.AutoEncoderConvDirect}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize TextEncoder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.TextEncoderConvDirect}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{CommonControls:Localize ControlNet}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AutoOption}}" SelectedItem="{Binding ExecutionOptions.ControlNetConvDirect}" Style="{StaticResource EnumComboBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize CPUExecution}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionCpuDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Columns="3" VerticalAlignment="Top">
                            <CheckBox Content="{CommonControls:Localize AutoEncoder}" IsChecked="{Binding ExecutionOptions.IsAutoEncoderCpuEnabled}"/>
                            <CheckBox Content="{CommonControls:Localize TextEncoder}" IsChecked="{Binding ExecutionOptions.IsTextEncoderCpuEnabled}"/>
                            <CheckBox Content="{CommonControls:Localize ControlNet}" IsChecked="{Binding ExecutionOptions.IsControlNetCpuEnabled}"/>
                        </UniformGrid>
                    </DockPanel>
                </Border>
                </StackPanel>

                <!--AudioCpp-->
                <StackPanel Visibility="{Binding Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AudioCpp}">
                <Border Style="{StaticResource WizardSection}">
                    <DockPanel>
                        <StackPanel Style="{StaticResource WizardSectionHeader}">
                            <TextBlock Text="{CommonControls:Localize Memory}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize ExecutionMemoryDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Columns="2" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize WeightType}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding WeightTypes}" SelectedItem="{Binding ExecutionOptions.WeightType}" Style="{StaticResource EnumComboBox}" ToolTip="{CommonControls:Localize ToolTip_WeightType}" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom"/>
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>
                </StackPanel>
        </StackPanel>
    </DockPanel>
</CommonControls:DialogControl>
