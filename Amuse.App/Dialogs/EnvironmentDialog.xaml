<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.EnvironmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:Common="clr-namespace:Amuse.App.Common"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="730"
        MaxWidth="730"
        x:Name="UI"
        Title="{CommonControls:Localize Title_EnvironmentSetup}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding ElementName=UI}" Margin="15, 15, 15, 10">

        <!--Save / Cancel-->
        <Grid DockPanel.Dock="Bottom"  Margin="0,15,0,0">
            <UniformGrid Columns="2" Height="30" HorizontalAlignment="Right">
                <Grid IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                    <Button Content="{CommonControls:Localize Create}" Command="{Binding CreateCommand}" Width="100" IsDefault="True" Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{CommonControls:Localize Update}" Command="{Binding UpdateCommand}" Width="100" IsDefault="True" Visibility="{Binding IsUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}" Width="100"/>
            </UniformGrid>
        </Grid>

        <!--Progress-->
        <Grid  DockPanel.Dock="Bottom">
            <StackPanel>
                <CommonControls:ProgressElement Progress="{Binding Progress}" Height="20" FontSize="10" />
                <DockPanel Margin="0,2,0,0" TextBlock.FontSize="11" Opacity=".8" >
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding DownloadSize, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Width="200">
                        <TextBlock Text="{Binding DownloadRemaining, StringFormat={}{0}}" Visibility="{Binding DownloadRemaining, Converter={StaticResource NullOrEmptyVisibilityConverter}}"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Right" Visibility="{Binding DownloadSize, Converter={StaticResource NullOrEmptyVisibilityConverter}}" Width="200">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DownloadSpeed, StringFormat={}{0}}" Visibility="{Binding DownloadSpeed, Converter={StaticResource NullOrEmptyVisibilityConverter}}"/>
                            <TextBlock Text="  |  " />
                            <TextBlock Text="{Binding DownloadSize}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding WaitMessage}" TextWrapping="Wrap" FontStyle="Italic" HorizontalAlignment="Center" Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>

        <DockPanel>
            <CommonControls:FontAwesome DockPanel.Dock="Left" Size="50" Margin="0,5,0,20" Icon="f059" IconStyle="Light" Color="{StaticResource InfoColour}" />
            <StackPanel Margin="20,2,0,0" >

                <!--Title-->
                <Grid HorizontalAlignment="Left" TextBlock.FontSize="16">
                    <TextBlock Text="{Binding Message}" />
                </Grid>

                <!--Message-->
                <Grid HorizontalAlignment="Left" Margin="0,3,0,0" TextBlock.FontStyle="Italic" TextBlock.FontSize="11" Opacity=".8">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding SubMessage, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>

                <!--Environment Options-->
                <Grid Margin="0,10,0,10" Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                    <ItemsControl ItemsSource="{Binding SetupItem.Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type Common:EnvironmentSetupOption}">
                                <Border Margin="0,2" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{StaticResource ListBoxBackground}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource ControlBrightDefaultBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ControlMouseOverBackground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton IsChecked="{Binding IsSelected}" VerticalContentAlignment="Top" Margin="8,6">
                                        <StackPanel Margin="2,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{CommonControls:Localize Installed}" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SuccessColour}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Grid Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Environment.DownloadSizeText}" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" Opacity=".6" Visibility="{Binding Environment.DownloadSizeText, Converter={StaticResource NullOrEmptyVisibilityConverter}}"/>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Environment.Description}" Margin="0,1,0,0" FontSize="10" Opacity=".7" TextWrapping="Wrap" Visibility="{Binding Environment.Description, Converter={StaticResource NullOrEmptyVisibilityConverter}}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </StackPanel>
        </DockPanel>

    </DockPanel>
</CommonControls:DialogControl>