<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.LoraModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:Common="clr-namespace:Amuse.App.Common"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        MinWidth="800"
        MaxWidth="800"
        Title="{CommonControls:Localize Title_LoraAdapterModel}"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LoraModelDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="{CommonControls:Localize Save}" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="{CommonControls:Localize Cancel}" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!--Main Content-->
        <StackPanel>

            <!--Model-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Model}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize LoraWizardModelDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <UniformGrid Columns="2" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="{CommonControls:Localize Pipeline}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <ComboBox ItemsSource="{Binding PipelineOptions}" SelectedItem="{Binding SelectedPipeline}" Style="{StaticResource EnumComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="{CommonControls:Localize ModelName}" Style="{StaticResource FieldTextBlockStyle}"/>
                            <TextBox Text="{Binding LoraModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!--Trigger Words-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{CommonControls:Localize TriggerWords}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize TagOptional}" FontSize="9" Opacity=".7" Margin="4,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{CommonControls:Localize LoraTriggerWordsDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel VerticalAlignment="Top">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Command="{Binding AddTriggerCommand}" Height="22" Width="40" Margin="3,0,0,0">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <TextBox Text="{Binding SelectedTrigger, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Trigger}" SelectedItem="{Binding SelectedTrigger}" ItemContainerStyle="{StaticResource TransparentListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0" Background="Transparent" BorderThickness="0" MinHeight="24">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"  />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ButtonBackgroundDisabled}" Margin="2">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType={x:Type local:LoraModelDialog}}}" CommandParameter="{Binding}" Style="{StaticResource TransparentButton}">
                                                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!--View Filter-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{CommonControls:Localize ViewFilter}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{CommonControls:Localize TagOptional}" FontSize="9" Opacity=".7" Margin="4,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{CommonControls:Localize LoraViewFilterDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ViewOptions}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type Common:ViewFilterOption}">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!--File-->
            <Border Style="{StaticResource WizardSection}">
                <DockPanel>
                    <StackPanel Style="{StaticResource WizardSectionHeader}">
                        <TextBlock Text="{CommonControls:Localize Lora}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{CommonControls:Localize LoraFileDescription}" FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Controls:CheckpointControl Margin="-4" Settings="{Binding Settings}" Checkpoint="{Binding LoraModel.Checkpoint}" SupportedTypes="{Binding CheckpointTypes, Mode=OneWay}">
                        <Controls:CheckpointControl.Style>
                            <Style TargetType="{x:Type Controls:CheckpointControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoraModel.Checkpoint.Type}" Value="OnlineFile">
                                        <Setter Property="Height" Value="150"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Controls:CheckpointControl.Style>
                    </Controls:CheckpointControl>
                </DockPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</CommonControls:DialogControl>
