                            <StackPanel Margin="0,3,0,0">
                                <TextBlock Text="{CommonControls:Localize Steps}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock Text="{Binding Options.Steps}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize Guidance}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock Text="{Binding Options.GuidanceScale}" />
                            </StackPanel>
                            <StackPanel Margin="0,3,0,0">
                                <TextBlock Text="{CommonControls:Localize Strength}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock Text="{Binding Options.Strength}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding LoraModels, Converter={StaticResource NullVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize LoraStrength}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ItemsControl ItemsSource="{Binding Options.LoraOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
