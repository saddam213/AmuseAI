                                <TextBlock DockPanel.Dock="Left"  Text="{CommonControls:Localize Model}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding ExtractModel}" Style="{StaticResource TextBlockStyle}" IsReadOnly="True" />
                            </StackPanel>
                            <UniformGrid Columns="3" Visibility="{Binding ExtractorType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Default}">
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize Tiled}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.IsTileEnabled}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize TileSize}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.TileSize, StringFormat={}{0} px}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize TileOverlap}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.TileOverlap, StringFormat={}{0} px}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="3" Visibility="{Binding ExtractorType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Background}">
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize BackgroundMode}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.Mode, Converter={StaticResource EnumDisplayNameConverter}}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="3" Visibility="{Binding ExtractorType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pose}">
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize Detections}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.Detections}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize JointConfidence}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBlock Text="{Binding ExtractOptions.JointConfidence, StringFormat={}{0:N2}}" />
