<Application x:Class="Amuse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amuse.App"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:CoreCommon="clr-namespace:TensorStack.Common;assembly=TensorStack.Common"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:AmuseCommon="clr-namespace:Amuse.Common;assembly=Amuse.Common"
             xmlns:Common="clr-namespace:Amuse.App.Common"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!--TensorStack.WPF-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TensorStack.WPF;component/ThemeDefault.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--Images-->
            <BitmapImage x:Key="ImageIcon" UriSource="pack://application:,,,/Amuse;component/Images/Icon.png" />

            <!--Fonts-->
            <FontFamily x:Key="FontAwesomeBrands">pack://application:,,,/Amuse;component/Fonts/Brands-Regular-400.otf#Font Awesome 7 Brands</FontFamily>
            <FontFamily x:Key="FontAwesomeLight">pack://application:,,,/Amuse;component/Fonts/Light-300.otf#Font Awesome 7 Pro Light</FontFamily>
            <FontFamily x:Key="FontAwesomeRegular">pack://application:,,,/Amuse;component/Fonts/Regular-400.otf#Font Awesome 7 Pro</FontFamily>
            <FontFamily x:Key="FontAwesomeSolid">pack://application:,,,/Amuse;component/Fonts/Solid-900.otf#Font Awesome 7 Pro Solid</FontFamily>
            <FontFamily x:Key="FontAwesomeThin">pack://application:,,,/Amuse;component/Fonts/Thin-100.otf#Font Awesome 7 Pro Thin</FontFamily>
            <FontFamily x:Key="FontAwesomeSharpLight">pack://application:,,,/Amuse;component/Fonts/Sharp-Light-300.otf#Font Awesome 7 Sharp Light</FontFamily>
            <FontFamily x:Key="FontAwesomeSharpRegular">pack://application:,,,/Amuse;component/Fonts/Sharp-Regular-400.otf#Font Awesome 7 Sharp</FontFamily>
            <FontFamily x:Key="FontAwesomeSharpSolid">pack://application:,,,/Amuse;component/Fonts/Sharp-Solid-900.otf#Font Awesome 7 Sharp Solid</FontFamily>
            <FontFamily x:Key="FontAwesomeSharpThin">pack://application:,,,/Amuse;component/Fonts/Sharp-Thin-100.otf#Font Awesome 7 Sharp Thin</FontFamily>


            <!--Amuse-->
            <ObjectDataProvider x:Key="NormalizationType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="CoreCommon:Normalization"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="BackendType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="CoreCommon:BackendType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="MediaType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="CoreCommon:MediaType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ExtractorType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:ExtractorType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="MemoryMode" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:MemoryMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="EnvironmentType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:EnvironmentType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ProcessType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:ProcessType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ModelSourceType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:ModelSourceType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="AutomationType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:AutomationType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="CheckpointType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:CheckpointType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ModelCategoryType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:ModelCategoryType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ModelFolderType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:ModelFolderType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="McpTransportType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Common:McpTransportType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="PipelineType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:PipelineType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DataType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:DataType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="SamplerType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:SamplerType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="SchedulerType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:SchedulerType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="LanguageType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:LanguageType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="CacheType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:CacheType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="LatentUpscale" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:LatentUpscale"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DiffusionCacheType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:DiffusionCacheType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="ControlNetType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:ControlNetType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="AutoOption" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:AutoOption"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="BackgroundMode" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="AmuseCommon:BackgroundMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>


            <!--Media Colours-->
            <Color x:Key="MediaImageColor">#FF0D72BA</Color>
            <Color x:Key="MediaVideoColor">#FF0D72BA</Color>
            <Color x:Key="MediaAudioColor">#FF74B768</Color>
            <Color x:Key="MediaTextColor">#FF74B768</Color>
            <SolidColorBrush x:Key="MediaImageBrush" Color="{StaticResource MediaImageColor}"/>
            <SolidColorBrush x:Key="MediaVideoBrush" Color="{StaticResource MediaVideoColor}"/>
            <SolidColorBrush x:Key="MediaAudioBrush" Color="{StaticResource MediaAudioColor}"/>
            <SolidColorBrush x:Key="MediaTextBrush" Color="{StaticResource MediaTextColor}"/>

            <!--Media Glow-->
            <RadialGradientBrush x:Key="MediaImageGlowBrush" Center="0,0" GradientOrigin="0,0" RadiusX="1.1" RadiusY="1.3">
                <GradientStop Color="#200D72BA" Offset="0"/>
                <GradientStop Color="#000D72BA" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="MediaVideoGlowBrush" Center="0,0" GradientOrigin="0,0" RadiusX="1.1" RadiusY="1.3">
                <GradientStop Color="#200D72BA" Offset="0"/>
                <GradientStop Color="#000D72BA" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="MediaAudioGlowBrush" Center="0,0" GradientOrigin="0,0" RadiusX="1.1" RadiusY="1.3">
                <GradientStop Color="#2074B768" Offset="0"/>
                <GradientStop Color="#0074B768" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="MediaTextGlowBrush" Center="0,0" GradientOrigin="0,0" RadiusX="1.1" RadiusY="1.3">
                <GradientStop Color="#2074B768" Offset="0"/>
                <GradientStop Color="#0074B768" Offset="1"/>
            </RadialGradientBrush>

            <!--Accent Border-->
            <LinearGradientBrush x:Key="AccentBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4D0D72BA" Offset="0"/>
                <GradientStop Color="#4D0D72BA" Offset="0.5"/>
                <GradientStop Color="#4D74B768" Offset="0.5"/>
                <GradientStop Color="#4D74B768" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentBorderLightBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E0D72BA" Offset="0"/>
                <GradientStop Color="#2E0D72BA" Offset="0.5"/>
                <GradientStop Color="#2E74B768" Offset="0.5"/>
                <GradientStop Color="#2E74B768" Offset="1"/>
            </LinearGradientBrush>

            <!--List Item Glow-->
            <LinearGradientBrush x:Key="ListItemGlowBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#180D72BA" Offset="0"/>
                <GradientStop Color="#000D72BA" Offset="1"/>
            </LinearGradientBrush>

            <!--Status Tints-->
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#204CAF50"/>
            <SolidColorBrush x:Key="SuccessTintBorderBrush" Color="#404CAF50"/>
            <SolidColorBrush x:Key="WarningTintBrush" Color="#20FFC107"/>
            <SolidColorBrush x:Key="WarningTintBorderBrush" Color="#50FFC107"/>
            <SolidColorBrush x:Key="InfoTintBrush" Color="#202E90D7"/>
            <SolidColorBrush x:Key="InfoTintBorderBrush" Color="#402E90D7"/>
            <SolidColorBrush x:Key="DangerTintBrush" Color="#20FE2929"/>
            <SolidColorBrush x:Key="DangerTintBorderBrush" Color="#40FE2929"/>

            <!--Card-->
            <Style x:Key="CardBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource ContainerBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!--Icon Tile-->
            <Style x:Key="IconTileBorder" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Opacity" Value=".15"/>
            </Style>

            <!--Chip-->
            <Style x:Key="ChipBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource ControlBrightDefaultBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!--Tag-->
            <Style x:Key="TagBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource ControlBrightDefaultBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="TagTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Margin" Value="6,0,6,1"/>
                <Setter Property="Opacity" Value=".75"/>
            </Style>

            <!--Status Tag-->
            <Style x:Key="StatusTagBorder" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="9,3,10,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="StatusTagSuccessBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusTagBorder}">
                <Setter Property="Background" Value="{StaticResource SuccessTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SuccessTintBorderBrush}"/>
            </Style>

            <Style x:Key="StatusTagWarningBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusTagBorder}">
                <Setter Property="Background" Value="{StaticResource WarningTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarningTintBorderBrush}"/>
            </Style>

            <Style x:Key="StatusTagInfoBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusTagBorder}">
                <Setter Property="Background" Value="{StaticResource InfoTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InfoTintBorderBrush}"/>
            </Style>

            <Style x:Key="StatusTagDangerBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource StatusTagBorder}">
                <Setter Property="Background" Value="{StaticResource DangerTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerTintBorderBrush}"/>
            </Style>

            <!--Section Header-->
            <Style x:Key="SectionHeaderTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Opacity" Value=".9"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionHeaderFontAwesome" TargetType="{x:Type CommonControls:FontAwesome}" BasedOn="{StaticResource {x:Type CommonControls:FontAwesome}}">
                <Setter Property="Size" Value="15"/>
                <Setter Property="IconStyle" Value="Regular"/>
                <Setter Property="Color" Value="{StaticResource AccentColour2}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!--Tile Button-->
            <Style x:Key="TileButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource ContainerBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource ButtonForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource ControlMouseOverBackground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ButtonBorderMouseOver}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ButtonBorderPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--Media Type-->
            <Style x:Key="MediaTypeFontAwesome" TargetType="{x:Type CommonControls:FontAwesome}" BasedOn="{StaticResource {x:Type CommonControls:FontAwesome}}">
                <Setter Property="Icon" Value="f1b2"/>
                <Setter Property="IconStyle" Value="Regular"/>
                <Setter Property="Color" Value="{StaticResource DefaultForeground}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MediaType}" Value="Image">
                        <Setter Property="Icon" Value="f03e"/>
                        <Setter Property="Color" Value="{StaticResource MediaImageBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Video">
                        <Setter Property="Icon" Value="f008"/>
                        <Setter Property="Color" Value="{StaticResource MediaVideoBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Audio">
                        <Setter Property="Icon" Value="f001"/>
                        <Setter Property="Color" Value="{StaticResource MediaAudioBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Text">
                        <Setter Property="Icon" Value="f893"/>
                        <Setter Property="Color" Value="{StaticResource MediaTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MediaTypeBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource IconTileBorder}">
                <Setter Property="Background" Value="{StaticResource DefaultForeground}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MediaType}" Value="Image">
                        <Setter Property="Background" Value="{StaticResource MediaImageBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Video">
                        <Setter Property="Background" Value="{StaticResource MediaVideoBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Audio">
                        <Setter Property="Background" Value="{StaticResource MediaAudioBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MediaType}" Value="Text">
                        <Setter Property="Background" Value="{StaticResource MediaTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="ImageDropZoneStyle" TargetType="{x:Type Border}">
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Image" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="Background" Value="#20000000"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VideoDropZoneStyle" TargetType="{x:Type Border}">
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Video" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AudioDropZoneStyle" TargetType="{x:Type Border}">
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Audio" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="TimelineDropButton" TargetType="{x:Type CommonControls:IconButton}">
                <Setter Property="IconSize" Value="18"/>
                <Setter Property="IconOpacity" Value=".8"/>
                <Setter Property="IconMargin" Value="0,6,0,0"/>
                <Setter Property="TextMargin" Value="0,-3,0,4"/>
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="IconColor" Value="{StaticResource DefaultForeground}"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"/>
                <Style.Triggers>
                    <Trigger Property="AllowDrop" Value="True">
                        <Setter Property="IconColor" Value="{StaticResource AccentColour2}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentColour2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TimelineOptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ToolTipService.Placement" Value="Top"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            </Style>


            <Style x:Key="TextDropZoneStyle" TargetType="{x:Type Border}">
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Text" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConversationDropZoneStyle" TargetType="{x:Type Border}">
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Conversation" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>


            <Style TargetType="{x:Type Controls:ContextControl}">
                <Setter Property="AllowDrop" Value="False"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding TextMaxCount, RelativeSource={RelativeSource Self}, Converter={StaticResource GreaterThanToBooleanConverter}, ConverterParameter=0}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Text" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding ImageMaxCount, RelativeSource={RelativeSource Self}, Converter={StaticResource GreaterThanToBooleanConverter}, ConverterParameter=0}" Value="True" />
                            <Condition Binding="{Binding IsDragDrop, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="True" />
                            <Condition Binding="{Binding DragDropType, RelativeSource={RelativeSource AncestorType=CommonControls:ViewControl}}" Value="Image" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="AllowDrop" Value="True"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
