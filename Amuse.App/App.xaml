            <DataTemplate DataType="{x:Type Common:DiffusionHistory}">
                <DockPanel Margin="10,0,0,0">
                    <TextBlock DockPanel.Dock="Top" FontSize="20">
                        <Run Text="{CommonControls:Localize Diffusion}"/>
                        <Run Text="{Binding MediaType}"/>
                    </TextBlock>
                    <StackPanel>
                        <Separator Opacity=".7"/>

                        <!--Models-->
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left"  Text="{CommonControls:Localize Model}" Style="{StaticResource FieldTextBlockStyle}" />
                            <TextBox Text="{Binding Model}" Style="{StaticResource TextBlockStyle}" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding LoraModels, Converter={StaticResource NullVisibilityConverter}, Mode=OneWay}">
                            <TextBlock DockPanel.Dock="Left"  Text="{CommonControls:Localize LoraModel}" Style="{StaticResource FieldTextBlockStyle}" />
                            <ItemsControl ItemsSource="{Binding LoraModels, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ., Mode=OneWay}" Style="{StaticResource TextBlockStyle}" IsReadOnly="True" Margin="0,0,4,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding ControlNetModel, Converter={StaticResource NullOrEmptyVisibilityConverter}}">
                            <TextBlock DockPanel.Dock="Left"  Text="{CommonControls:Localize ControlNetModel}" Style="{StaticResource FieldTextBlockStyle}" />
                            <TextBox Text="{Binding ControlNetModel}" Style="{StaticResource TextBlockStyle}" IsReadOnly="True" />
                        </StackPanel>

                        <!--Details-->
                        <UniformGrid Columns="3" Margin="0,4,0,0" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image|Video}">
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize Size}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock>
                                   <Run Text="{Binding Width}" />
                                   <Run Text="x" />
                                   <Run Text="{Binding Height}" />
                                   <Run Text="px" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}">
                                <TextBlock Text="{CommonControls:Localize FrameRate}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock>
                                   <Run Text="{Binding FrameRate}" />
                                   <Run Text="fps" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}">
                                <TextBlock Text="{CommonControls:Localize Frames}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBlock Text="{Binding FrameCount}" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,4,0,0" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Audio}">
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize Duration}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="{Binding Duration, FallbackValue=00:00:00, StringFormat={}mm\\:ss\\.ff}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize SampleRate}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="{Binding SampleRate, FallbackValue=0hz, StringFormat={}{0}hz}" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,4,0,0" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                            <!--<StackPanel>
                                <TextBlock Text="{CommonControls:Localize Duration}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="{Binding Duration, FallbackValue=00:00:00, StringFormat={}mm\\:ss\\.ff}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{CommonControls:Localize SampleRate}" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBlock Text="{Binding SampleRate, FallbackValue=0hz, StringFormat={}{0}hz}" />
                            </StackPanel>-->
                        </UniformGrid>


                        <!--Prompts-->
                        <StackPanel Visibility="{Binding MediaType, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Text}">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{CommonControls:Localize Prompt}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding Options.Prompt}" Style="{StaticResource TextBlockStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="200"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Visibility="{Binding Options.NegativePrompt, Converter={StaticResource NullOrEmptyVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize NegativePrompt}" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding Options.NegativePrompt}" Style="{StaticResource TextBlockStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="200"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Visibility="{Binding Options.Prompt2, Converter={StaticResource NullOrEmptyVisibilityConverter}}">
