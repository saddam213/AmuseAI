<Window x:Class="Amuse.App.Splashscreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Height="350"
        Width="600"
        Background="Transparent" 
        Foreground="#FFC8C8C8"
        WindowStartupLocation="CenterScreen" 
        Icon="/Images/Icon.ico" 
        Cursor="AppStarting" 
        Focusable="False"
        IsHitTestVisible="False"
        IsTabStop="False"
        Name="UI">
    <Border DataContext="{Binding ElementName=UI}" UseLayoutRounding="True" BorderBrush="#800D72BA" BorderThickness="1,1,0,0" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="Fant">
        <Border BorderBrush="#8074B768" BorderThickness="0,0,1,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF23323D" Offset="0"/>
                    <GradientStop Color="#FF272727" Offset="0.5"/>
                    <GradientStop Color="#FF30382F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Images/Splash_Logo.png" Width="200" Opacity=".95" />
                <TextBlock Text="{Binding Title}" TextAlignment="Center" FontSize="15"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
