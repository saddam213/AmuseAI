<CommonControls:BaseControl x:Class="Amuse.App.Controls.MediaReferenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MediaReferenceControl}}}">

        <!--Add/Clear-->
        <UniformGrid Rows="1" Height="35" DockPanel.Dock="Bottom">
            <Button Command="{Binding AddImageCommand}" ToolTip="{CommonControls:Localize ReferenceAddImage}" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <CommonControls:FontAwesome Icon="f03e"/>
                    <TextBlock FontSize="11" Opacity=".8" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding ImageCount, Mode=OneWay}"/>/<Run Text="{Binding ImageMaxCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding AddVideoCommand}" ToolTip="{CommonControls:Localize ReferenceAddVideo}" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <CommonControls:FontAwesome Icon="f008"/>
                    <TextBlock FontSize="11" Opacity=".8" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding VideoCount, Mode=OneWay}"/>/<Run Text="{Binding VideoMaxCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding AddAudioCommand}" ToolTip="{CommonControls:Localize ReferenceAddAudio}" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <CommonControls:FontAwesome Icon="f001"/>
                    <TextBlock FontSize="11" Opacity=".8" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding AudioCount, Mode=OneWay}"/>/<Run Text="{Binding AudioMaxCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearCommand}" >
                <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}"/>
            </Button>
        </UniformGrid>

        <Grid Margin="0,0,0,6">
            <Grid.Resources>
                <CollectionViewSource x:Key="ReferenceView" Source="{Binding ReferenceCollection}" IsLiveSortingRequested="True">
                    <CollectionViewSource.SortDescriptions>
                        <scm:SortDescription PropertyName="MediaType" Direction="Ascending"/>
                        <scm:SortDescription PropertyName="Index" Direction="Ascending"/>
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>
            </Grid.Resources>

            <ListBox ItemsSource="{Binding Source={StaticResource ReferenceView}}" SelectedItem="{Binding SelectedReferenceItem}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type local:ReferenceItemModel}" >
                        <DockPanel ToolTip="{Binding ToolTipMessage}">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="3">
                                <Grid>
                                    <!--Audio-->
                                    <Border BorderThickness="1" BorderBrush="{StaticResource DefaultForeground}" Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Audio}">
                                        <CommonControls:FontAwesome Icon="f001"/>
                                    </Border>

                                    <!--Image-->
                                    <CommonControls:TransparentImageElement 
                                            Height="40" 
                                            Stretch="Uniform" 
                                            DecodePixelHeight="40"
                                            BitmapSource="{Binding Image, Converter={StaticResource ImageTensorToBitmapConverter}}" 
                                            Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}" />

                                    <!--Video-->
                                    <CommonControls:TransparentImageElement 
                                            Height="40" 
                                            Stretch="Uniform" 
                                            DecodePixelHeight="40"
                                            BitmapSource="{Binding Video.Thumbnail, Converter={StaticResource ImageTensorToBitmapConverter}}" 
                                            Visibility="{Binding MediaType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}" />
                                </Grid>
                            </Border>

                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0" >
                                <Button Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MediaReferenceControl}}}" CommandParameter="{Binding}">
                                    <CommonControls:FontAwesome Icon="f00d" Size="13" Color="{StaticResource DangerColour}" Opacity="1" Margin="2"/>
                                </Button>
                            </Grid>

                            <StackPanel Margin="3" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{Binding MediaType, Mode=OneWay}"/> <Run Text="{Binding Index, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Filename, Converter={StaticResource FullPathToFileNameConverter}}" FontStyle="Italic" Opacity=".8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <DockPanel.Style>
                                <Style TargetType="{x:Type DockPanel}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                            <Setter Property="Opacity" Value=".2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <Border BorderThickness="1" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:MediaReferenceControl}}}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessColour}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ReferenceCollection.Count, Converter={StaticResource LessThanToVisibilityConverter}, ConverterParameter=1}" Opacity=".6" Margin="0,-40,0,0">
                    <TextBlock Text="{CommonControls:Localize ReferenceEmpty}" TextAlignment="Center"/>
                    <TextBlock Text="{CommonControls:Localize ReferenceEmptyMessage}" TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</CommonControls:BaseControl>
