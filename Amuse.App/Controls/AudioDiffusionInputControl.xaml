<CommonControls:BaseControl x:Class="Amuse.App.Controls.AudioDiffusionInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:Amuse.App"
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             xmlns:Common="clr-namespace:Amuse.App.Common"
             xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:AudioDiffusionInputControl}}}">
        <Grid.Resources>
            <Style x:Key="DiffusionInputTab" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsExecuting}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="IsEnabled" Value="False"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsAutomating}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="IsEnabled" Value="False"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>


        <TabControl Margin="0,14,0,14" SelectedIndex="{Binding SelectedOption, Converter={StaticResource EnumToIntConverter}}">

            <!--Options-->
            <TabItem Style="{StaticResource DiffusionInputTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <CommonControls:FontAwesome Icon="f1de" IconStyle="Solid" Color="{StaticResource AccentColour2}" Size="13"/>
                        <TextBlock Text="{CommonControls:Localize Options}" FontSize="11" FontWeight="DemiBold" Opacity=".9" Margin="5,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,4,0,0" >

                    <!--TextToMusic-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextToMusic}" >

                        <UniformGrid Columns="2">

                            <!--Seed-->
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}"/>
                            </StackPanel>

                            <!--Task-->
                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Tasks.Length, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=1}">
                                <TextBlock Text="{CommonControls:Localize Task}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding Options.Task}" />
                            </StackPanel>

                        </UniformGrid>

                        <!--Steps-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Steps, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Steps}" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" />
                        </StackPanel>

                        <!--Guidance Scale-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Guidance}" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2"/>
                        </StackPanel>

                        <!--Strength-->
                        <StackPanel Visibility="{Binding IsStrengthSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Strength}" Value="{Binding Options.Strength}"  IsPercent="True"  Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                        </StackPanel>

                        <!--BPM-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.BPM, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize BPM}" Value="{Binding Options.Bpm}" Minimum="30" Maximum="300" TickFrequency="1"/>
                        </StackPanel>

                        <UniformGrid Columns="2">

                            <DockPanel Margin="0,0,2,0">
                                <ToggleButton x:Name="ToggleButtonDurations" DockPanel.Dock="Right" Style="{StaticResource ToggleButtonBasic}" Width="25" Height="22" VerticalAlignment="Bottom">
                                    <CommonControls:FontAwesome Icon="f1ec" IconStyle="Light" Size="12"/>
                                </ToggleButton>
                                <Grid>
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="{CommonControls:Localize Duration}" Style="{StaticResource FieldTextBlockStyle}" />
                                        <ComboBox ItemsSource="{Binding Durations}" SelectedValue="{Binding Options.Duration}" SelectedValuePath="FloatValue" DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{CommonControls:Localize DurationSeconds}" Style="{StaticResource FieldTextBlockStyle}" />
                                        <TextBox Text="{Binding Options.Duration}" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>

                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.BPM, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                                <TextBlock Text="{CommonControls:Localize TimeSignature}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding TimeSignatures}" SelectedValue="{Binding Options.TimeSignature}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,2,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.BPM, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                                <TextBlock Text="{CommonControls:Localize Keyscale}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding KeyScales}" SelectedValue="{Binding Options.Keyscale}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                            </StackPanel>

                        </UniformGrid>

                    </StackPanel>

                    <!--AudioToMusic-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AudioToMusic}" >

                        <UniformGrid Columns="2">

                            <!--Seed-->
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}"/>
                            </StackPanel>

                            <!--Task-->
                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Tasks, Converter={StaticResource InverseEmptyToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize Task}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding Options.Task}" />
                            </StackPanel>

                        </UniformGrid>

                        <!--Range-->
                        <StackPanel Margin="0,2,0,0" Visibility="{Binding IsRangeSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{CommonControls:Localize AudioRange}" Style="{StaticResource FieldTextBlockStyle}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="25" Height="22" Command="{Binding SelectRangeCommand}" ToolTip="{CommonControls:Localize ToolTip_SelectAudioRange}" ToolTipService.InitialShowDelay="200">
                                    <CommonControls:FontAwesome Icon="f545" IconStyle="Light" Size="12"/>
                                </Button>
                                <TextBox Text="{Binding RangeText, Mode=OneWay}" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>

                        <!--Track Name-->
                        <StackPanel Margin="0,2,0,0" Visibility="{Binding IsTrackNameSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{CommonControls:Localize TrackName}" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:PlaceholderTextBox Text="{Binding Options.TrackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="{CommonControls:Localize TrackNamePlaceholder}" PlaceholderOpacity=".5" ToolTip="{CommonControls:Localize ToolTip_TrackName}" ToolTipService.InitialShowDelay="200"/>
                        </StackPanel>

                        <UniformGrid Columns="2">

                            <!--Steps-->
                            <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Steps, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                                <CommonControls:SliderControl Text="{CommonControls:Localize Steps}" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" />
                            </StackPanel>

                            <!--Guidance Scale-->
                            <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                                <CommonControls:SliderControl Text="{CommonControls:Localize Guidance}" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2"/>
                            </StackPanel>

                        </UniformGrid>


                        <!--Strength-->
                        <StackPanel Visibility="{Binding IsStrengthSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Strength}" Value="{Binding Options.Strength}"  IsPercent="True"  Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                        </StackPanel>

                        <!--Duration-->
                        <DockPanel Visibility="{Binding IsDurationSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ToggleButton x:Name="ToggleButtonDurations3" DockPanel.Dock="Right" Style="{StaticResource ToggleButtonBasic}" Width="25" Height="22" VerticalAlignment="Bottom">
                                <CommonControls:FontAwesome Icon="f1ec" IconStyle="Light" Size="12"/>
                            </ToggleButton>
                            <Grid>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations3, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{CommonControls:Localize Duration}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <ComboBox ItemsSource="{Binding Durations}" SelectedValue="{Binding Options.Duration}" SelectedValuePath="FloatValue" DisplayMemberPath="Label" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{CommonControls:Localize DurationSeconds}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding Options.Duration}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                    </StackPanel>

                    <!--TextToAudio-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextToAudio}" >

                        <UniformGrid Columns="2">

                            <!--Seed-->
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}"/>
                            </StackPanel>

                            <!--VoiceStyle-->
                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Tasks, Converter={StaticResource InverseEmptyToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize VoiceStyle}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Pipeline.DiffusionModel.DefaultOptions.Tasks}" SelectedItem="{Binding Options.Task}" />
                            </StackPanel>

                            <!--Language-->
                            <StackPanel Margin="0,0,2,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Languages, Converter={StaticResource InverseEmptyToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize Language}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Pipeline.DiffusionModel.DefaultOptions.Languages}" SelectedItem="{Binding Options.Language}" />
                            </StackPanel>

                            <!--Emotion-->
                            <StackPanel Margin="0,0,2,0" Visibility="{Binding IsEmotionSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize Emotion}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Emotions}" SelectedValue="{Binding Options.Emotion}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                            </StackPanel>

                        </UniformGrid>

                        <!--Instruction-->
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding IsInstructionSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize Instruction}" Style="{StaticResource FieldTextBlockStyle}" />
                            <Border Style="{StaticResource TextDropZoneStyle}" Height="100">
                                <CommonControls:PlaceholderTextBox Text="{Binding Options.Instruction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="{CommonControls:Localize InstructionPlaceholder}" PlaceholderOpacity=".5" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </DockPanel>

                        <!--Steps-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Steps, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Steps}" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" />
                        </StackPanel>

                        <!--Guidance Scale-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Guidance}" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2"/>
                        </StackPanel>

                        <!--Speed-->
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Speed, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Value="{Binding Options.Speed}" Text="{CommonControls:Localize Speed}" Minimum="0.5" Maximum="5" TickFrequency="0.01" ValuePostFix="x" ValueFormat="N1"/>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,0" Visibility="{Binding IsSpeechPipeline, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <ToggleButton x:Name="ToggleButtonDurations2" DockPanel.Dock="Right" Style="{StaticResource ToggleButtonBasic}" Width="25" Height="22" VerticalAlignment="Bottom">
                                <CommonControls:FontAwesome Icon="f1ec" IconStyle="Light" Size="12"/>
                            </ToggleButton>
                            <Grid>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations2, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{CommonControls:Localize Duration}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <ComboBox ItemsSource="{Binding Durations}" SelectedValue="{Binding Options.Duration}" SelectedValuePath="FloatValue" DisplayMemberPath="Label" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ToggleButtonDurations2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{CommonControls:Localize DurationSeconds}" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding Options.Duration}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                    </StackPanel>

                    <!--VoiceClone-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=VoiceClone}" >

                        <UniformGrid Columns="2">
                            <!--Seed-->
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!--Steps-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Steps, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Steps}" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" />
                        </StackPanel>

                        <!--Guidance Scale-->
                        <StackPanel Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=0}">
                            <CommonControls:SliderControl Text="{CommonControls:Localize Guidance}" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2"/>
                        </StackPanel>
                    </StackPanel>

                    <!--AudioToText-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AudioToText}" >

                        <UniformGrid Columns="2" >

                            <StackPanel Margin="0,0,1,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}" />
                            </StackPanel>

                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Languages, Converter={StaticResource InverseEmptyToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize Language}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:LanguageControl SupportedLanguages="{Binding Pipeline.DiffusionModel.DefaultOptions.Languages}" SelectedLanguage="{Binding Options.Language}" />
                            </StackPanel>

                            <StackPanel Margin="2,0,0,0" Visibility="{Binding Pipeline.DiffusionModel.DefaultOptions.Tasks, Converter={StaticResource InverseEmptyToVisibilityConverter}}">
                                <TextBlock Text="{CommonControls:Localize Task}" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Pipeline.DiffusionModel.DefaultOptions.Tasks}" SelectedItem="{Binding Options.Task}" />
                            </StackPanel>

                        </UniformGrid>

                        <StackPanel Margin="0,4,0,0">
                            <CommonControls:SliderControl Text="{CommonControls:Localize ChunkSize}" Value="{Binding Options.ChunkSize}" Minimum="0" Maximum="30" TickFrequency="1" />
                        </StackPanel>
                    </StackPanel>

                    <!--Negative Prompt-->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsNegativePromptSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding Options.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=1, FallbackValue=Collapsed}">
                            <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize NegativePrompt}" Style="{StaticResource FieldTextBlockStyle}" />
                            <Border Style="{StaticResource TextDropZoneStyle}" Height="100">
                                <CommonControls:PlaceholderTextBox Text="{Binding Options.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </DockPanel>
                    </StackPanel>

                    <!--Lora Strength-->
                    <ItemsControl ItemsSource="{Binding Options.LoraOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                                    <CommonControls:SliderControl Text="{CommonControls:Localize Lora}"  IsPercent="True" Minimum="0.01" Maximum="2" TickFrequency="0.01" Value="{Binding Strength}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid IsItemsHost="True">
                                    <UniformGrid.Style>
                                        <Style TargetType="{x:Type UniformGrid}">
                                            <Setter Property="Columns" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Options.LoraOptions.Count}" Value="1">
                                                    <Setter Property="Columns" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                </UniformGrid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </DockPanel>
            </TabItem>


            <!--Advanced, unused placeholder so Automation keeps its InputTabOption index-->
            <TabItem Visibility="Collapsed" />


            <!--Automation-->
            <TabItem Style="{StaticResource DiffusionInputTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <CommonControls:FontAwesome Icon="e0b6" IconStyle="Solid" Color="{StaticResource AccentColour2}" Size="12"/>
                        <TextBlock Text="{CommonControls:Localize Automation}" FontSize="11" FontWeight="DemiBold" Opacity=".9" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>

                    <!--Progress-->
                    <CommonControls:ProgressElement DockPanel.Dock="Bottom" Progress="{Binding AutomationProgress}" />

                    <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{CommonControls:Localize Automation}" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding AutomationOptions.Types}" SelectedItem="{Binding AutomationOptions.Type}" Style="{StaticResource EnumComboBox}" />
                        </StackPanel>

                        <!--Seed-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Seed}">
                            <UniformGrid Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize AutomationCount}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding AutomationOptions.Count, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!--PromptFiles-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PromptFiles}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize PromptFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!--PromptLines-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PromptLines}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize PromptFile}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsRequired="True" Filter="{CommonControls:Localize TextFiles, Append='|*.txt;'}" DefaultExt="txt"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!--ImageFiles-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=InputFiles}">
                            <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ImageToImage|ImageEdit|ImageToVideo}">
                                <UniformGrid Margin="0,0,0,0" >
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize ImageFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="{CommonControls:Localize UseInputSize}" IsChecked="{Binding AutomationOptions.UseInputSize}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel  Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=VideoToVideo}">
                                <UniformGrid Margin="0,0,0,0" >
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize VideoFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel  Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextToAudio}">
                                <UniformGrid Margin="0,0,0,0" >
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize TextFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel  Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AudioToText}">
                                <UniformGrid Margin="0,0,0,0" >
                                    <StackPanel>
                                        <TextBlock Text="{CommonControls:Localize AudioFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>


                        <!--HistoryEnabled-->
                        <CheckBox Content="{CommonControls:Localize OutputHistory}" IsChecked="{Binding AutomationOptions.IsHistoryEnabled}" Margin="0,4,0,0"/>


                        <!--OutputDirectory-->
                        <CheckBox Content="{CommonControls:Localize OutputLocation}" IsChecked="{Binding AutomationOptions.UseOutputDirectory}" Margin="0,4,0,0"/>
                        <Grid Visibility="{Binding AutomationOptions.UseOutputDirectory,Converter={StaticResource BooleanToVisibilityConverter}}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize OutputFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>

                </DockPanel>
            </TabItem>


            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                        <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </Grid>
</CommonControls:BaseControl>
