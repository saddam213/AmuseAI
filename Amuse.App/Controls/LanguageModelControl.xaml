<CommonControls:BaseControl x:Class="Amuse.App.Controls.LanguageModelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:Amuse.App"
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             xmlns:Common="clr-namespace:Amuse.App.Common"
             xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LanguageModelControl}}}">

        <DockPanel>

            <DockPanel DockPanel.Dock="Bottom">

                <!--Load/Unload-->
                <DockPanel DockPanel.Dock="Right" Width="90" Height="22" Margin="0,2,0,0">
                    <Button x:Name="UnloadButton" DockPanel.Dock="Right" Command="{Binding UnloadCommand}" Width="22">
                        <CommonControls:FontAwesome Icon="f00d" IconStyle="Solid" >
                            <CommonControls:FontAwesome.Style>
                                <Style TargetType="{x:Type CommonControls:FontAwesome}" BasedOn="{StaticResource {x:Type CommonControls:FontAwesome}}">
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=UnloadButton}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Setter Property="Color" Value="{StaticResource DangerColour}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CommonControls:FontAwesome.Style>
                        </CommonControls:FontAwesome>
                    </Button>

                    <Grid>
                        <Button x:Name="LoadButton" Command="{Binding LoadCommand}" >
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="{CommonControls:Localize Load}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=LoadButton}" Value="False">
                                            <Setter Property="Content" Value="{CommonControls:Localize Loading}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid Visibility="{Binding IsEnabled, ElementName=LoadButton, Converter={StaticResource InverseBooleanToHiddenConverter}, FallbackValue=Hidden}">
                            <Border Background="{StaticResource ButtonBackground}" BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1" Visibility="{Binding IsPipelineLoaded, Converter={StaticResource BooleanToHiddenConverter}, FallbackValue=Hidden}">
                                <DockPanel Margin="4,0" HorizontalAlignment="Center" Opacity=".8">
                                    <CommonControls:FontAwesome DockPanel.Dock="Left" Icon="f058" Size="12" Color="{StaticResource SuccessColour}" Margin="0,1,0,0"/>
                                    <TextBlock Text="{CommonControls:Localize Ready}" Margin="4,2,0,0" Foreground="{StaticResource SuccessColour}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                </DockPanel>

                <!--Options-->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="1,0,0,0">

                </StackPanel>


            </DockPanel>

            <StackPanel>

                <!--Device-->
                <DockPanel>
                    <TextBox DockPanel.Dock="Left" Text="{CommonControls:Localize Device}" IsReadOnly="True" IsHitTestVisible="False" Width="60" FontStyle="Italic" FontSize="11" Opacity="0.7" Padding="4,2,0,0"/>
                    <Grid>
                        <ComboBox 
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding SelectedDevice}" 
                            ItemsSource="{Binding DeviceCollectionView}" 
                            SelectionChanged="Device_SelectionChanged" />
                        <TextBlock Text="{CommonControls:Localize NoDevicesFound}" FontStyle="Italic" Opacity=".4" Margin="5,2,0,0" IsHitTestVisible="False" Visibility="{Binding DeviceCollectionView.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </DockPanel>

                <!--Model-->
                <DockPanel>
                    <TextBox DockPanel.Dock="Left" Text="{CommonControls:Localize Model}" IsReadOnly="True" IsHitTestVisible="False" Width="60" FontStyle="Italic" FontSize="11" Opacity="0.7" Padding="4,2,0,0"/>
                    <Grid Height="36">
                        <CommonControls:ContentComboBox 
                            SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                            ItemsSource="{Binding ModelCollectionView}"
                            ItemTemplate="{StaticResource ComboBoxDataDiffusionTemplateModel}"
                            HorizontalContentAlignment="Stretch"
                            SelectionChanged="Model_SelectionChanged">
                            <CommonControls:ContentComboBox.BottomContent>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Height="26" Width="26" Command="{Binding SettingsCommand}" CommandParameter="Language" >
                                        <CommonControls:FontAwesome Icon="f013" Size="12"/>
                                    </Button>
                                    <CommonControls:ToggleButton DockPanel.Dock="Right" Width="26" Height="26" IconTrue="f0b0" IconFalse="f0b0" SizeTrue="12" SizeFalse="12" ColorTrue="{StaticResource ToggleIconOnColour}" ColorFalse="{StaticResource ToggleIconOffColour}" ToolTipTrue="{CommonControls:Localize ToolTip_ModelFilterInstalled}" ToolTipFalse="{CommonControls:Localize ToolTip_ModelFilterAll}" ToolTipPlacement="Top" ToolTipInitialDelay="200" IsChecked="{Binding Settings.IsInstalledModelsOnly, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                    <UniformGrid Rows="1">
                                        <Button Content="{CommonControls:Localize Install}" Height="26" Command="{Binding InstallCommand}" CommandParameter="Language"/>
                                        <Button Content="{CommonControls:Localize Download}" Height="26" Command="{Binding DownloadCommand}" CommandParameter="Language"/>
                                    </UniformGrid>
                                </DockPanel>
                            </CommonControls:ContentComboBox.BottomContent>
                        </CommonControls:ContentComboBox>
                        <TextBlock Text="{CommonControls:Localize NoModelsFound}" FontStyle="Italic" Opacity=".4" Margin="5,-2,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding ModelCollectionView.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </DockPanel>


                <DockPanel>
                    <TextBox DockPanel.Dock="Left" Text="{CommonControls:Localize Memory}" IsReadOnly="True" IsHitTestVisible="False" Width="60" FontStyle="Italic" FontSize="11" Opacity="0.7" Padding="4,2,0,0"/>
                    <Button DockPanel.Dock="Right" Height="22" Width="22" Command="{Binding ExecutionOptionsCommand}" Visibility="{Binding SelectedModel.Backend, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=StableDiffusionCpp|LlamaCpp|AudioCpp}">
                        <CommonControls:FontAwesome Icon="f013" Size="11" Opacity=".8" />
                    </Button>
                    <UniformGrid Rows="1">

                        <!--MemoryMode-->
                        <ComboBox SelectedItem="{Binding SelectedMemoryMode}" 
                            ItemsSource="{Binding MemoryModes}"
                            HorizontalContentAlignment="Stretch"
                            SelectionChanged="Memory_SelectionChanged"
                            ToolTip="{Binding SelectedMemoryMode.Description}"
                            ToolTipService.Placement="Left"
                            ToolTipService.InitialShowDelay="600"
                            ToolTipService.VerticalOffset="-2"
                            ToolTipService.HorizontalOffset="-2"
                            ToolTipService.HasDropShadow="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel
                                    HorizontalAlignment="Stretch"
                                    ToolTip="{Binding Description}"
                                    ToolTipService.Placement="Left"
                                    ToolTipService.InitialShowDelay="300"
                                    ToolTipService.VerticalOffset="-5"
                                    ToolTipService.HorizontalOffset="-8"
                                    ToolTipService.HasDropShadow="True">
                                        <TextBlock DockPanel.Dock="Right" Opacity=".7" FontSize="10" Text="{Binding DetectedMode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}, StringFormat={}({0})}" Margin="0,1,0,0" Visibility="{Binding MemoryMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Auto}"/>
                                        <TextBlock Text="{Binding MemoryMode, Converter={StaticResource EnumDisplayNameConverter}}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--Quant-->
                        <DockPanel Visibility="{Binding SelectedModel.HasCheckpointSets, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <ComboBox
                                ItemsSource="{Binding CheckpointCollection}"
                                SelectedItem="{Binding SelectedCheckpoint}"
                                HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel HorizontalAlignment="Stretch">
                                            <CommonControls:FontAwesome DockPanel.Dock="Right" Style="{StaticResource CheckpointStatusFontAwesome}" Size="10" IconStyle="Solid" Width="15" ToolTipService.InitialShowDelay="200"/>
                                            <TextBlock DockPanel.Dock="Right" Opacity=".7" FontSize="10" Text="{Binding MemorySize, StringFormat={}{0:0.#}GB}" Margin="0,1,4,0"/>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                    </UniformGrid>
                </DockPanel>
            </StackPanel>
        </DockPanel>

    </Grid>
</CommonControls:BaseControl>
