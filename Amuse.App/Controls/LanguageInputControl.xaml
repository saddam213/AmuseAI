<CommonControls:BaseControl x:Class="Amuse.App.Controls.LanguageInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:Amuse.App"
             xmlns:local="clr-namespace:Amuse.App.Controls"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Amuse.App.Controls"
             xmlns:Common="clr-namespace:Amuse.App.Common"
             xmlns:Views="clr-namespace:Amuse.App.Views">
    <Grid  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LanguageInputControl}}}" >
        <Grid.Resources>
            <Style x:Key="DiffusionInputTab" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsExecuting}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="IsEnabled" Value="False"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsAutomating}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="IsEnabled" Value="False"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>


        <TabControl Margin="0,14,0,0" SelectedIndex="{Binding SelectedOption, Converter={StaticResource EnumToIntConverter}}">

            <!--Options-->
            <TabItem Style="{StaticResource DiffusionInputTab}" >
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <CommonControls:FontAwesome Icon="f1de" IconStyle="Solid" Color="{StaticResource AccentColour2}" Size="13"/>
                        <TextBlock Text="{CommonControls:Localize Options}" FontSize="11" FontWeight="DemiBold" Opacity=".9" Margin="5,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,4,0,0" >

                    <StackPanel DockPanel.Dock="Top"  >
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,2,0" IsEnabled="False">
                                <TextBlock Text="{CommonControls:Localize Presets}" Style="{StaticResource FieldTextBlockStyle}" />
                                <DockPanel>
                                    <UniformGrid DockPanel.Dock="Right" Columns="2">
                                        <CommonControls:AddOnButton Icon="f00c" IconSize="12" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8"/>
                                        <CommonControls:AddOnButton Icon="f0c7" IconSize="13" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8" />
                                    </UniformGrid>
                                    <ComboBox />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="{CommonControls:Localize Seed}" Style="{StaticResource FieldTextBlockStyle}" />
                                <Controls:SeedControl Seed="{Binding Options.Seed}"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,2,0,0">
                            <CommonControls:SliderControl Text="{CommonControls:Localize MinLength}" Value="{Binding Options.MinLength}" Maximum="{Binding Pipeline.LanguageModel.DefaultOptions.MaxLength}" TickFrequency="1" />
                            <CommonControls:SliderControl Text="{CommonControls:Localize MaxLength}" Value="{Binding Options.MaxLength}" Maximum="{Binding Pipeline.LanguageModel.DefaultOptions.MaxLength}" TickFrequency="1024" />
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="-1,8,0,4">
                            <CheckBox Content="{CommonControls:Localize ThinkingEnabled}" IsChecked="{Binding Options.IsThinkingEnabled}" FontStyle="Italic" FontSize="11" Opacity=".9"/>
                            <CheckBox Content="Tool Calls Enabled" IsChecked="{Binding Options.IsToolCallsEnabled}" FontStyle="Italic" FontSize="11" Opacity=".9"/>
                        </UniformGrid>
                       
                    </StackPanel>

    
                    <!--Image Select-->
                    <StackPanel DockPanel.Dock="Top"  Visibility="{Binding IsInputImagesEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{CommonControls:Localize Inputs}" Style="{StaticResource FieldTextBlockStyle}" />
                        <Controls:SourceSelectControl 
                            Height="22"
                            FontSize="12"
                            SourceCount="4"
                            IsMultiSelect="True" 
                            TextHorizontalAlignment="Center"
                            SourceText1="Image 1"
                            SourceText2="Image 2"
                            SourceText3="Image 3"
                            SourceText4="Image 4"
                            IsSource1Selected="{Binding Options.IsSource1Enabled, Mode=TwoWay}"
                            IsSource2Selected="{Binding Options.IsSource2Enabled, Mode=TwoWay}"
                            IsSource3Selected="{Binding Options.IsSource3Enabled, Mode=TwoWay}"
                            IsSource4Selected="{Binding Options.IsSource4Enabled, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid Margin="0,2,0,0">

                        <!--Prompt-->
                        <DockPanel Visibility="{Binding IsPromptEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize Prompt}" Style="{StaticResource FieldTextBlockStyle}" />
                            <Border Style="{StaticResource TextDropZoneStyle}" >
                                <CommonControls:PlaceholderTextBox Text="{Binding Options.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                            </Border>
                        </DockPanel>

                        <!--Context-->
                        <Border Visibility="{Binding IsPromptEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{CommonControls:Localize ConversationContext}" Style="{StaticResource FieldTextBlockStyle}" Visibility="{Binding ViewType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextConverse}"/>
                                    <TextBlock Text="{CommonControls:Localize AdditionalContext}" Style="{StaticResource FieldTextBlockStyle}" Visibility="{Binding ViewType, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=TextConverse}"/>
                                </StackPanel>
                                <Controls:ContextControl x:Name="ContextControlElement" IsControlBusy="{Binding IsControlBusy, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </DockPanel>
                           
                        </Border>

                    </Grid>

                </DockPanel>
            </TabItem>

            <!--Advanced-->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <CommonControls:FontAwesome Icon="f085" IconStyle="Solid" Color="{StaticResource AccentColour2}" Size="12"/>
                        <TextBlock Text="{CommonControls:Localize Advanced}" FontSize="11" FontWeight="DemiBold" Opacity=".9" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,4,0,8">

                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,4,0,0">
                        <CommonControls:SliderControl Text="Beams" Value="{Binding Options.Beams}" Minimum="1" Maximum="20" TickFrequency="1" />
                        <CommonControls:SliderControl Text="Temperature" Value="{Binding Options.Temperature}" Minimum="0.1" Maximum="5" TickFrequency="0.01" ValueFormat="N2"/>
                        <CommonControls:SliderControl Text="TopK" Value="{Binding Options.TopK}" Minimum="1" Maximum="100" TickFrequency="1" />
                        <CommonControls:SliderControl Text="TopP" Value="{Binding Options.TopP}" Minimum="0.01" Maximum="1" TickFrequency="0.01" ValueFormat="N2"/>
                        <CommonControls:SliderControl Text="TopH" Value="{Binding Options.TopH}" Minimum="0.01" Maximum="1" TickFrequency="0.01" ValueFormat="N2"/>
                        <CommonControls:SliderControl Text="TypicalP" Value="{Binding Options.TypicalP}" Minimum="0.01" Maximum="1" TickFrequency="0.01" ValueFormat="N2"/>
                        <CommonControls:SliderControl Text="{CommonControls:Localize LengthPenalty}" Value="{Binding Options.LengthPenalty}" Minimum="-5" Maximum="5" TickFrequency="0.05" ValueFormat="N2" />
                        <CommonControls:SliderControl Text="{CommonControls:Localize RepetitionPenalty}" Value="{Binding Options.RepetitionPenalty}" Minimum="0.05" Maximum="5" TickFrequency="0.05" ValueFormat="N2" />
                        <CommonControls:SliderControl Text="{CommonControls:Localize NoRepeatNgrams}" Value="{Binding Options.NoRepeatNgramSize}" Minimum="0" Maximum="10" TickFrequency="1" ValueFormat="N0" />
                        <CheckBox Content="{CommonControls:Localize SamplingEnabled}" IsChecked="{Binding Options.IsSamplingEnabled}" Margin="4,13,0,0" FontStyle="Italic" FontSize="11" Opacity=".9"/>
                    </UniformGrid>

                    <UniformGrid DockPanel.Dock="Top" Columns="2">
                        <StackPanel>
                            <TextBlock Text="{CommonControls:Localize KVCache}" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource CacheType}}" SelectedItem="{Binding Options.CacheType}" Style="{StaticResource EnumComboBox}" />
                        </StackPanel>
                    </UniformGrid>

                    <Grid DockPanel.Dock="Bottom" Visibility="{Binding Options.Beams, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock FontSize="11" Foreground="{StaticResource WarningColour}" TextAlignment="Center" Opacity=".8" Margin="0,10,0,0" >
                            <Run Text="{CommonControls:Localize Note, Append=:}" FontWeight="SemiBold" />
                            <Run Text="Beam results won't be displayed until all beams have completed"/>
                        </TextBlock>
                    </Grid>

                    <!--System Prompt-->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{CommonControls:Localize SystemPrompt}" Style="{StaticResource FieldTextBlockStyle}" />
                        <Border Style="{StaticResource TextDropZoneStyle}" >
                            <CommonControls:PlaceholderTextBox Text="{Binding Options.Prompt2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>
                    </DockPanel>

                </DockPanel>
            </TabItem>

            <!--Automation-->
            <TabItem Style="{StaticResource DiffusionInputTab}" Visibility="{Binding ViewType, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=TextConverse}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <CommonControls:FontAwesome Icon="e0b6" IconStyle="Solid" Color="{StaticResource AccentColour2}" Size="12"/>
                        <TextBlock Text="{CommonControls:Localize Automation}" FontSize="11" FontWeight="DemiBold" Opacity=".9" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,0,0,8">
                    <!--Progress-->
                    <CommonControls:ProgressElement DockPanel.Dock="Bottom" Progress="{Binding AutomationProgress}" />
                    <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{CommonControls:Localize Automation}" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding AutomationOptions.Types}" SelectedItem="{Binding AutomationOptions.Type}" Style="{StaticResource EnumComboBox}" />
                        </StackPanel>

                        <!--PromptFiles-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PromptFiles}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize PromptFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!--PromptLines-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PromptLines}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize PromptFile}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsRequired="True" Filter="Text Files|*.txt;" DefaultExt="txt"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!--ImageFiles-->
                        <Grid Visibility="{Binding AutomationOptions.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=InputFiles}">
                            <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ImageToText}">
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize ImageFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                </StackPanel>
                                <StackPanel  Margin="0,4,0,0">
                                    <TextBlock Text="{CommonControls:Localize OutputPrefix}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox Text="{Binding AutomationOptions.OutputPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Content="{CommonControls:Localize OutputSeed}" IsChecked="{Binding AutomationOptions.OutputPostFixSeed}"  Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    
                        <!--HistoryEnabled-->
                        <CheckBox Content="{CommonControls:Localize OutputHistory}" IsChecked="{Binding AutomationOptions.IsHistoryEnabled}" Margin="0,4,0,0"/>

                        <!--OutputDirectory-->
                        <CheckBox  Content="{CommonControls:Localize OutputLocation}" IsChecked="{Binding AutomationOptions.UseOutputDirectory}" Margin="0,4,0,0"/>
                        <Grid Visibility="{Binding AutomationOptions.UseOutputDirectory,Converter={StaticResource BooleanToVisibilityConverter}}">
                            <UniformGrid Margin="0,0,0,0" >
                                <StackPanel>
                                    <TextBlock Text="{CommonControls:Localize OutputFolder}" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox FileName="{Binding AutomationOptions.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" IsRequired="True" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>

                </DockPanel>
            </TabItem>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                        <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </Grid>
</CommonControls:BaseControl>
